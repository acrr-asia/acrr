{
  "name": "acrr",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && node scripts/check-site-url.mjs",
    "build:local": "astro check && astro build && pagefind --site dist && node scripts/check-site-url.mjs --allow-localhost",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:site-url": "node scripts/check-site-url.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "katex": "^0.19.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "playwright": "1.56.1",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3"
  }
}
