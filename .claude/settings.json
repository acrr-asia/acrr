{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run build:local)",
      "Bash(npm run preview)",
      "Bash(npm run check)",
      "Bash(npm run check:links)",
      "Bash(npm run check:site-url)",
      "Bash(SITE_URL=https://acrr.asia npm run build)",
      "Bash(npx astro check)",
      "Bash(npx astro build:*)",
      "Bash(npx astro preview stop)",
      "Bash(node scripts/check-links.mjs:*)",
      "Bash(node scripts/check-site-url.mjs:*)",
      "Bash(python3 scripts/generate-diagrams.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
