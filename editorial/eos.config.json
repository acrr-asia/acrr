      "AI",
      "ML"
    ]
  },
  "references": {
    "sectionHeadings": [
      "References",
      "Further reading"
    ],
    "policy": "Cite primary or authoritative sources: standards, RFCs, peer-reviewed papers, textbooks from established publishers and official documentation. Every entry must be verifiable; never invent a reference, edition, year or URL. URLs are added only when they have been checked."
  },
  "review": {
    "recordsDir": "editorial/records",
    "auditDir": "editorial/audit",
    "stages": [
      "developmental",
      "copy",
      "factCheck",
      "technical",
      "series",
      "publishing",
      "qa"
    ],
    "requiredStages": {
      "article": [
        "developmental",
        "copy",
        "factCheck",
        "technical",
        "publishing",
        "qa"
      ],
      "insight": [
        "developmental",
        "copy",
        "factCheck",
        "technical",
        "publishing",
        "qa"
      ],
      "series": [
        "developmental",
        "copy",
        "series",
        "publishing",
        "qa"
      ]
    },
    "minimumTotal": {
      "article": 24,
      "insight": 22,
      "series": 22
    },
    "minimumPerDimension": 3
  },
  "validation": {
    "commands": [
      {
        "name": "Build (types, schemas, MDX, KaTeX, Mermaid, search index)",
        "run": "npm run build",
        "env": {
          "SITE_URL": "https://acrr.asia"
        }
      },
      {
        "name": "Internal links and fragments",
        "run": "npm run check:links"
      },
      {
        "name": "Series review gate",
        "run": "node scripts/series-pipeline.mjs gate"
      }
    ],
    "site": {
      "dist": "dist",
      "ignore": [
        "pagefind/**"
      ],
      "maxDiagramMinWidthPx": 620,
      "descriptionMaxChars": 170,
      "ignoreDuplicateIds": [
        "^actor-man-(torso|arms)\\d+$"
      ]
    }
  },
