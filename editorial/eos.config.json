{
  "$schema": "../plugins/editorial-os/schema/eos.config.schema.json",
  "version": 1,
  "publication": {
    "id": "acrr",
    "name": "ACRR",
    "fullName": "Advanced Computing & Robotics Research",
    "url": "https://acrr.asia",
    "standards": "editorial/standards.md",
    "identity": "An independent research and technical publication on computing, control, robotics and the engineering methods that connect them. It explains established methods carefully, states assumptions and limits, and keeps facts, interpretations and open questions apart.",
    "audience": "Engineering and computer-science students from the second year of a degree upwards, practising engineers moving into an adjacent field, and researchers who want a careful reference. Readers know calculus and basic linear algebra and can read Python; each series states anything beyond that."
  },
  "language": {
    "variant": "en-US",
    "serialComma": false,
    "contractions": "avoid",
    "headingCase": "sentence",
    "titleCase": "headline"
  },
  "content": {
    "root": ".",
    "types": {
      "article": {
        "label": "Article",
        "globs": [
          "src/content/blog/*.mdx",
          "src/content/blog/*.md"
        ],
        "route": "/blog/{slug}",
        "rubric": "article",
        "requiredFields": [
          "title",
          "description",
          "publishedAt"
        ]
      },
      "insight": {
        "label": "Insight",
        "globs": [
          "src/content/insights/*.md",
          "src/content/insights/*.mdx"
        ],
        "route": "/insights/{slug}",
        "rubric": "insight",
        "requiredSections": [
          "Established",
          "Interpretation",
          "Open questions"
        ],
        "requiredFields": [
          "title",
          "description",
          "publishedAt"
        ]
      },
      "series": {
        "label": "Series overview",
        "globs": [
          "src/content/series/*.md"
        ],
        "route": "/series/{slug}",
        "rubric": "series",
        "isSeriesIndex": true,
        "requiredFields": [
          "title",
          "description",
          "status"
        ]
      }
    },
    "exclude": [
      "src/content/**/vi/**"
    ],
    "fields": {
      "title": "title",
      "description": "description",
      "published": "publishedAt",
      "updated": "updatedAt",
      "series": "series",
      "seriesOrder": "seriesOrder",
      "draft": "draft",
      "example": "example",
      "status": "status",
      "plannedEntries": "plannedEntries"
    },
    "seriesArticle": {
      "requiredSections": [
        "Summary",
        "References"
      ],
      "entryNoun": "entry"
    },
    "pages": {
      "dist": "dist",
      "routes": [
        "/",
        "/about",
        "/learning",
        "/blog",
        "/series",
        "/insights",
        "/tags",
        "/404"
      ],
      "sources": {
        "/": "src/views/Home.astro",
        "/about": "src/views/About.astro",
        "/learning": "src/views/Learning.astro + src/data/learning.json",
        "/blog": "src/views/BlogIndex.astro",
        "/series": "src/views/SeriesIndex.astro",
        "/insights": "src/views/InsightsIndex.astro",
        "/tags": "src/views/TagsIndex.astro",
        "/404": "src/pages/404.astro"
      },
      "prefixes": [
        "/tags/",
        "/blog/category/",
        "/vi/"
      ]
    },
    "translations": {
      "vi": "{dir}/vi/{file}"
    }
  },
  "thresholds": {
    "titleMaxChars": 70,
    "descriptionMinChars": 70,
    "descriptionMaxChars": 165,
    "sentenceMaxWords": 45,
    "paragraphMaxWords": 170,
    "headingMaxWords": 12
  },
  "glossary": "editorial/glossary.json",
  "rules": {
    "spelling-variant": "error",
    "terminology": "warning",
    "phrases": "warning",
    "intensifiers": "suggestion",
    "contractions": "warning",
    "doubled-word": "error",
    "placeholder": "error",
    "sentence-length": "suggestion",
    "paragraph-length": "suggestion",
    "exclamation": "warning",
    "heading-levels": "error",
    "heading-case": "warning",
    "heading-numbering": "warning",
    "heading-punctuation": "warning",
    "heading-duplicate": "warning",
    "heading-length": "suggestion",
    "title-length": "warning",
    "description-length": "warning",
    "description-form": "warning",
    "required-fields": "error",
    "required-sections": "error",
    "series-sections": "warning",
    "opening-paragraph": "warning",
    "internal-link": "error",
    "series-crossref": "error",
    "link-text": "warning",
    "math-balance": "error",
    "acronym-expansion": "suggestion",
    "reference-format": "suggestion"
  },
  "acronyms": {
    "known": [
      "AC",
      "DC",
      "CPU",
      "RAM",
      "ROM",
      "USB",
      "PDF",
      "HTML",
      "CSS",
      "URL",
      "API",
