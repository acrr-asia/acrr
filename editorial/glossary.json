{
  "$comment": "ACRR terminology and phrase rules. Read by plugins/editorial-os/scripts/eos.mjs (lint, vale-style) and by the copy-editing stage. 'avoid' entries are regular expressions matched against prose only (code, math, URLs, JSX and front-matter keys are masked). Add a term when the same concept has appeared in two forms; record the reason in 'note'.",
  "terms": [
    {
      "prefer": "endpoint",
      "avoid": [
        "\\bend-point(s?)\\b"
      ],
      "note": "Closed compound, as in RFC 9110 and the OAuth specifications.",
      "replace": "endpoint$1"
    },
    {
      "prefer": "time step",
      "avoid": [
        "\\btime-step(s?)\\b(?! size)",
        "\\btimestep(s?)\\b"
      ],
      "note": "Open compound as a noun; hyphenate only as a modifier before another noun (time-step size).",
      "replace": "time step$1"
    },
    {
      "prefer": "data set",
      "avoid": [
        "\\bdataset(s?)\\b"
      ],
      "note": "House form, the majority form in the archive. Product names keep their own spelling.",
      "replace": "data set$1"
    },
    {
      "prefer": "setpoint",
      "avoid": [
        "\\bset-point(s?)\\b",
        "\\bset point(s?)\\b"
      ],
      "note": "Closed compound, as in IEC 60050 and process-control usage.",
      "replace": "setpoint$1"
    },
    {
      "prefer": "Ethernet",
      "avoid": [
        "(?<![-/\\w])ethernet\\b"
      ],
      "caseSensitive": true,
      "note": "Proper noun (IEEE 802.3).",
      "replace": "Ethernet"
    },
    {
      "prefer": "Kalman filter",
      "avoid": [
        "\\bKalman Filter(s?)\\b"
      ],
      "caseSensitive": true,
      "scope": "body",
      "note": "Only the eponym is capitalized in running text.",
      "replace": "Kalman filter$1"
    },
    {
      "prefer": "OAuth 2.0",
      "avoid": [
        "\\bOAuth ?2(?![.\\d])",
        "\\bOAuth2\\b"
      ],
      "caseSensitive": true,
      "note": "Name the version as RFC 6749 does; write OAuth 2.1 only for the draft."
    },
    {
      "prefer": "microcontroller",
      "avoid": [
        "\\bmicro-controller(s?)\\b"
      ],
      "replace": "microcontroller$1"
    },
    {
      "prefer": "nonlinear",
      "avoid": [
        "\\bnon-linear(ly|ity)?\\b"
      ],
      "replace": "nonlinear$1"
    },
    {
      "prefer": "subsystem",
      "avoid": [
        "\\bsub-system(s?)\\b"
      ],
      "replace": "subsystem$1"
    },
    {
      "prefer": "trade-off",
      "avoid": [
        "\\btradeoff(s?)\\b",
        "\\btrade off(s?)\\b(?= (between|is|in|of))"
      ],
      "note": "Hyphenated noun; the verb is 'trade off'."
    },
    {
      "prefer": "email",
      "avoid": [
        "\\be-mail(s?)\\b"
      ],
      "replace": "email$1"
    },
    {
      "prefer": "website",
      "avoid": [
        "\\bweb site(s?)\\b"
      ],
      "replace": "website$1"
    },
    {
      "prefer": "real-time (adjective) / real time (noun)",
      "avoid": [
        "\\breal time (system|operating|scheduling|constraint|deadline|task|kernel|clock|control|guarantee)s?\\b"
      ],
      "note": "Hyphenate the compound modifier."
    },
    {
      "prefer": "state-space (adjective) / state space (noun)",
      "avoid": [
        "\\bstate space (model|form|representation|description|equation|realization|matrices|matrix)s?\\b"
      ],
      "note": "Hyphenate the compound modifier."
    },
    {
      "prefer": "closed-loop / open-loop (adjective)",
      "avoid": [
        "\\b(closed|open) loop (system|response|pole|gain|transfer|control|stability|behavior|dynamics|matrix|eigenvalue)s?\\b"
      ],
      "note": "Hyphenate the compound modifier; 'the loop is closed' and 'in closed loop' stay open."
    },
    {
      "prefer": "floating-point (adjective)",
      "avoid": [
        "\\bfloating point (number|arithmetic|value|format|error|operation|unit|representation)s?\\b"
      ]
    },
    {
      "prefer": "z-transform",
      "avoid": [
        "\\bZ-transform(s?)\\b",
        "\\bz transform(s?)\\b"
      ],
      "caseSensitive": true
    },
    {
      "prefer": "Laplace transform",
      "avoid": [
        "\\blaplace transform"
      ],
      "caseSensitive": true
    },
    {
      "prefer": "Fourier transform",
      "avoid": [
        "\\bfourier\\b"
      ],
      "caseSensitive": true
    },
    {
      "prefer": "Python 3",
      "avoid": [],
      "note": "State the version once per article where code is shown (see standards, Stated versions and defaults)."
    },
    {
      "prefer": "proportional-integral-derivative (PID)",
      "avoid": [
        "\\bP\\.I\\.D\\.?"
      ],
      "note": "Expand on first use in each article."
    },
    {
      "prefer": "I2C",
      "avoid": [
        "\\bI²C\\b",
        "\\bIIC\\b"
      ],
      "caseSensitive": true,
      "note": "ASCII form, used consistently in the embedded series."
    },
    {
      "prefer": "per cent sign (%) with numbers",
      "avoid": [
        "\\b\\d+(\\.\\d+)? percent\\b"
      ],
      "note": "Write 2% with a numeral; spell out 'percent' only without a numeral."
    }
  ],
  "phrases": [
    {
      "avoid": "\\bdelve(s|d)? into\\b",
      "message": "Generic AI-style phrasing; say what the section does ('describes', 'derives', 'compares')."
    },
    {
      "avoid": "\\bin today'?s (fast-paced|rapidly evolving|digital|modern) (world|landscape|era)\\b",
      "message": "Empty opener; start with the subject."
    },
    {
      "avoid": "\\b(ever-evolving|ever-changing|rapidly evolving) (landscape|field|world)\\b",
      "message": "Empty framing; state the specific change, or cut."
    },
    {
      "avoid": "\\bplays? a (crucial|pivotal|vital|key|critical) role\\b",
      "message": "Vague claim of importance; say what it does."
    },
    {
      "avoid": "\\b(is|are) a testament to\\b",
      "message": "Promotional phrasing."
    },
    {
      "avoid": "\\bnavigat(e|ing) the (complexities|intricacies|landscape)\\b",
      "message": "Generic AI-style phrasing."
    },
    {
      "avoid": "\\b(unlock|unleash|harness) the (full )?(power|potential)\\b",
      "message": "Marketing language."
    },
    {
      "avoid": "\\b(game-changer|game changer|cutting-edge|state-of-the-art|groundbreaking|revolutionary|seamless(ly)?)\\b",
      "message": "Hype word; replace with a specific, checkable property or cut."
    },
    {
      "avoid": "\\bit is (important|worth|crucial) to (note|mention|remember|emphasize) that\\b",
      "message": "Throat-clearing; state the point directly."
    },
    {
      "avoid": "\\bit('s| is) worth noting that\\b",
      "message": "Throat-clearing; state the point directly."
    },
    {
      "avoid": "\\bneedless to say\\b",
      "message": "If it needs no saying, cut it."
    },
    {
      "avoid": "\\bin conclusion,",
      "message": "Signpost; the final section's heading already says this."
    },
    {
      "avoid": "\\b(at the end of the day|when all is said and done|the bottom line is)\\b",
      "message": "Cliché."
    },
    {
      "avoid": "\\b(a myriad of|a plethora of)\\b",
      "message": "Wordy; use 'many' or give the number."
    },
    {
      "avoid": "\\b(in order to)\\b",
      "message": "Usually 'to' suffices.",
      "severity": "suggestion"
    },
    {
      "avoid": "\\b(due to the fact that|owing to the fact that)\\b",
      "message": "Use 'because'."
    },
    {
      "avoid": "\\b(the fact that)\\b",
      "message": "Often removable; check the sentence.",
      "severity": "suggestion"
    },
    {
      "avoid": "\\b(utili[sz]e[sd]?|utili[sz]ing|utili[sz]ation)\\b",
      "message": "Use 'use'."
    },
    {
      "avoid": "\\b(leverag(e|es|ed|ing))\\b",
      "message": "Business jargon; use 'use' or 'exploit'."
    },
    {
      "avoid": "\\b(robust and scalable|scalable and robust)\\b",
      "message": "Paired buzzwords; say what scales and what it is robust to."
    },
    {
      "avoid": "\\bas (we|you) can see\\b",
      "message": "Signpost; show the result instead."
    },
    {
      "avoid": "\\b(let's|let us) dive\\b",
      "message": "Generic AI-style phrasing."
    },
    {
      "avoid": "\\bthis (article|entry|post) (will )?(explore|explores|dive|dives)\\b",
      "message": "Say what the text does: describes, derives, compares, measures."
    },
    {
      "avoid": "\\b(comprehensive|holistic) (guide|overview|understanding)\\b",
      "message": "Self-praise; let the content show its scope."
    }
  ],
  "intensifiers": [
    "very",
    "extremely",
    "really",
    "quite",
    "highly",
    "incredibly",
    "clearly",
    "obviously",
    "simply",
    "basically",
    "essentially",
    "actually",
    "truly",
    "undoubtedly",
    "of course"
  ]
}
