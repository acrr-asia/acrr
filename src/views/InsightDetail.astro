---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TagList from '../components/TagList.astro';
import { baseId, entryLang, formatDate, hasTranslation } from '../lib/content';
import { kindLabel, localizePath, t } from '../i18n/ui';

interface Props { insight: CollectionEntry<'insights'> }

const { insight } = Astro.props;
const { data } = insight;
const lang = entryLang(insight);
const ui = t(lang);
const id = baseId(insight);
const counterpart = lang === 'en' ? ((await hasTranslation('insights', id)) ? `/insights/${id}` : null) : `/insights/${id}`;
const copy = {
  en: {
    eyebrow: 'Insight',
    exampleTitle: 'Example insight.',
    exampleText: 'This piece is sample content that demonstrates the Established, Interpretation, and Open questions format. It is not a research result.',
    back: '← All insights',
  },
  vi: {
    eyebrow: 'Góc nhìn',
    exampleTitle: 'Góc nhìn ví dụ.',
    exampleText: 'Bài này là nội dung mẫu minh họa định dạng Đã xác lập, Diễn giải và Câu hỏi còn mở. Đây không phải kết quả nghiên cứu.',
    back: '← Tất cả góc nhìn',
  },
}[lang];
const { Content, remarkPluginFrontmatter } = await render(insight);
const minutesRead = remarkPluginFrontmatter?.minutesRead as number | undefined;
---
<Base title={data.title} description={data.description} narrow example={data.example ? 'insight' : undefined} counterpart={counterpart}>
  <article>
    <header>
      <p class="eyebrow" data-pagefind-ignore>{copy.eyebrow}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <p class="meta" data-pagefind-ignore>
        <time datetime={data.publishedAt.toISOString().slice(0, 10)}>{formatDate(data.publishedAt, lang)}</time>
        <span class="badge kind">{kindLabel(data.kind, lang)}</span>
        {data.example && <span class="badge notice">{ui.example}</span>}
        {data.draft && <span class="badge">{ui.draft}</span>}
        {minutesRead && <span>{ui.minRead(minutesRead)}</span>}
      </p>
    </header>

    {data.example && (
      <aside class="example-notice" aria-label={copy.exampleTitle}>
        <p><strong>{copy.exampleTitle}</strong> {copy.exampleText}</p>
      </aside>
    )}

    <div class="prose body">
      <Content />
    </div>

    <div class="tags" data-pagefind-ignore><TagList tags={data.tags} /></div>

    <p class="back"><a href={localizePath('/insights', lang)}>{copy.back}</a></p>
  </article>
</Base>

<style>
  header .meta { align-items: center; margin-top: var(--space-3); }

  .example-notice {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
  }
  .example-notice p { margin: 0; }

  .body { margin-top: var(--space-4); }
  /* The three section headings (Established / Interpretation / Open questions) are the page structure. */
  .body :global(h2) {
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: 1.35rem;
  }
  .body :global(h2:first-child) { margin-top: 0; }

  .tags { margin-top: var(--space-5); }

  .back { margin-top: var(--space-4); }
</style>
