---
import Base from '../layouts/Base.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { baseId, getSeriesList, getSeriesPosts } from '../lib/content';
import { langFromUrl } from '../i18n/ui';

const lang = langFromUrl(Astro.url);
const statusRank = { published: 0, 'in-progress': 1, planned: 2 } as const;

const seriesList = (await getSeriesList(lang)).sort(
  (a, b) => statusRank[a.data.status] - statusRank[b.data.status] || a.data.title.localeCompare(b.data.title, lang),
);

// Published = non-draft articles only (drafts appear in `astro dev`, but are never counted).
const items = await Promise.all(
  seriesList.map(async (series) => {
    const posts = await getSeriesPosts(baseId(series), lang);
    return { series, count: posts.filter((p) => !p.data.draft).length };
  }),
);

const hasExamples = seriesList.some((s) => s.data.example);
const copy = {
  en: {
    title: 'Series',
    description: 'Structured collections of articles that follow a subject in sequence, with published entries listed first and planned entries marked as such.',
    eyebrow: 'Structured reading',
    lede: 'A series groups related articles into a sequence so that a subject can be followed in order. Each series lists its published articles first, then entries that are planned but not yet written.',
    exampleTitle: 'Example / illustrative series.',
    exampleText: 'The series below show how ACRR intends to organize multi-part material. Entries marked “Planned” do not exist yet, and articles marked “Example” are sample content, not completed research.',
    empty: 'No series have been added yet.',
  },
  vi: {
    title: 'Loạt bài',
    description: 'Các tập hợp bài viết có cấu trúc, đi theo một chủ đề theo trình tự; các bài đã đăng được liệt kê trước, các bài dự kiến được đánh dấu rõ.',
    eyebrow: 'Đọc theo lộ trình',
    lede: 'Một loạt bài nhóm các bài viết liên quan thành một trình tự để có thể theo dõi một chủ đề từ đầu đến cuối. Mỗi loạt liệt kê các bài đã đăng trước, sau đó là các bài dự kiến nhưng chưa viết.',
    exampleTitle: 'Loạt bài ví dụ / minh họa.',
    exampleText: 'Các loạt bài dưới đây cho thấy ACRR dự định tổ chức nội dung nhiều phần như thế nào. Các mục đánh dấu “Dự kiến” chưa tồn tại, và các bài đánh dấu “Ví dụ” là nội dung mẫu, không phải nghiên cứu đã hoàn thành.',
    empty: 'Chưa có loạt bài nào.',
  },
}[lang];
---
<Base title={copy.title} description={copy.description} searchable={false}>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.title}</h1>
  <p class="lede">{copy.lede}</p>

  {hasExamples && (
    <aside class="example-notice" aria-label={copy.exampleTitle}>
      <p><strong>{copy.exampleTitle}</strong> {copy.exampleText}</p>
    </aside>
  )}

  {items.length > 0 ? (
    <ul class="list">
      {items.map(({ series, count }) => (
        <li><SeriesCard series={series} count={count} level={2} /></li>
      ))}
    </ul>
  ) : (
    <p>{copy.empty}</p>
  )}
</Base>

<style>
  .example-notice {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    max-width: var(--measure);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
  }
  .example-notice p { margin: 0; }
  .list { margin-top: var(--space-4); }
</style>
