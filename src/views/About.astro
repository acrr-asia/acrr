---
import Base from '../layouts/Base.astro';
import { localizedAreas } from '../components/home/research-areas';
import { langFromUrl, localizePath } from '../i18n/ui';

const lang = langFromUrl(Astro.url);
const href = (path: string) => localizePath(path, lang);
const researchAreas = localizedAreas(lang);

const copy = {
  en: {
    title: 'About',
    description: 'The mission, research scope, working principles and long-term direction of ACRR, an independent research and technical publishing platform.',
    eyebrow: 'about',
    h1: 'About ACRR',
    lede: 'ACRR, Advanced Computing & Robotics Research, is an independent research and technical publishing platform. This page explains what it is for and how it intends to work.',
    mission: 'Mission',
    missionText: 'To explore advanced computing and robotics through rigorous technical study, experimentation, and research-oriented publishing.',
    scope: 'Research scope',
    scopeText: 'ACRR proposes to investigate the following fields. They are areas of interest. Listing a field here does not mean there is an active project, a funded program or a staffed laboratory in it.',
    principles: 'Working principles',
    principlesText: 'These are the standards the writing on this site is meant to be held to.',
    principleList: [
      { title: 'Technical accuracy', text: 'Statements are checked before they are published, and errors are corrected when they are found.' },
      { title: 'Reproducibility where applicable', text: 'When an article describes a computation or an experiment, it should give enough detail for a reader to repeat it.' },
      { title: 'Clear assumptions and limitations', text: 'Every method works under some conditions and fails outside them. Articles state which.' },
      { title: 'Evidence-based conclusions', text: 'Conclusions follow from derivations, measurements or cited sources, not from assertion.' },
      { title: 'Continuous learning and iteration', text: 'Understanding improves and errors are found, so articles are revised. A substantive revision is dated on the article.' },
      { title: 'Established results and exploratory ideas kept apart', text: 'Established results, interpretations and open questions are labeled as different things.' },
    ],
    review: 'Editorial standards',
    reviewIntro: 'ACRR follows a written set of editorial standards. Before an article, series or insight is published, it passes the same review stages:',
    reviewStages: [
      { title: 'Structure and argument', text: 'purpose, intended reader, the order of ideas and the depth of explanation.' },
      { title: 'Language', text: 'precise and consistent American English, one term for one concept, and no padding.' },
      { title: 'Facts and sources', text: 'claims, dates, standards and numbers checked against primary or authoritative sources, and every reference checked to exist and to support what it is cited for.' },
      { title: 'Technical accuracy', text: 'definitions, derivations, equations and worked numbers rechecked, and code run where it can be.' },
      { title: 'Series review', text: 'each series read as one publication, for its sequence, notation and cross-references.' },
      { title: 'Publishing checks', text: 'build, links, metadata, mathematics, diagrams and accessibility.' },
    ],
    reviewOutro: 'A final check scores each item against written acceptance criteria. An item with an uncorrected error, an unverifiable source or a false cross-reference is not published, and a claim that could not be verified is stated as such rather than presented as fact.',
    direction: 'Long-term direction',
    directionText: 'ACRR starts as an independent publishing platform: articles, series, insights and an index of learning resources. The intention is to develop it, step by step, into a more comprehensive research environment that may eventually support projects, collaboration and laboratory activities. That is a direction, not a description of the present, and no timeline is implied.',
    aboutSite: 'About the content and the author',
    contentText: ['Articles, series and insights are published once they are complete. Series and entries that have not been written yet are labeled as planned. Any sample material that only illustrates a format is marked', 'Example', 'and should not be read as completed original research.'],
    languages: 'Articles are written in English. Vietnamese translations are published under /vi as they are completed; where a translation and the English original differ, the original is authoritative.',
    personal: "This page deliberately contains no personal biography, credentials, affiliations or contact details. Personal information is added only when it is supplied by the site's author.",
    continueLabel: 'Continue exploring',
    continueEyebrow: 'continue',
    links: [['/blog', 'Read the blog'], ['/series', 'Browse series'], ['/insights', 'See insights'], ['/learning', 'Browse learning resources']],
  },
  vi: {
    title: 'Giới thiệu',
    description: 'Sứ mệnh, phạm vi nghiên cứu, nguyên tắc làm việc và định hướng dài hạn của ACRR, một nền tảng độc lập về nghiên cứu và xuất bản kỹ thuật.',
    eyebrow: 'giới thiệu',
    h1: 'Giới thiệu ACRR',
    lede: 'ACRR (Advanced Computing & Robotics Research – Nghiên cứu Điện toán Tiên tiến & Robot) là một nền tảng độc lập về nghiên cứu và xuất bản kỹ thuật. Trang này giải thích ACRR dùng để làm gì và dự định hoạt động ra sao.',
    mission: 'Sứ mệnh',
    missionText: 'Tìm hiểu điện toán tiên tiến và robot thông qua nghiên cứu kỹ thuật chặt chẽ, thực nghiệm và xuất bản theo định hướng nghiên cứu.',
    scope: 'Phạm vi nghiên cứu',
    scopeText: 'ACRR đề xuất tìm hiểu các lĩnh vực dưới đây. Đó là những lĩnh vực quan tâm; việc liệt kê một lĩnh vực ở đây không có nghĩa là đang có dự án, chương trình được tài trợ hay phòng thí nghiệm có nhân sự trong lĩnh vực đó.',
    principles: 'Nguyên tắc làm việc',
    principlesText: 'Đây là những tiêu chuẩn mà các bài viết trên trang này hướng tới.',
    principleList: [
      { title: 'Chính xác về kỹ thuật', text: 'Các nhận định được kiểm tra trước khi đăng, và sai sót được sửa khi phát hiện.' },
      { title: 'Có thể tái lập khi phù hợp', text: 'Khi một bài viết mô tả một phép tính hay một thí nghiệm, bài cần cung cấp đủ chi tiết để người đọc có thể làm lại.' },
      { title: 'Giả định và giới hạn rõ ràng', text: 'Mỗi phương pháp chỉ đúng trong một số điều kiện và thất bại ngoài các điều kiện đó. Bài viết nêu rõ đó là những điều kiện nào.' },
      { title: 'Kết luận dựa trên bằng chứng', text: 'Kết luận được rút ra từ suy luận, phép đo hoặc nguồn được trích dẫn, không phải từ khẳng định suông.' },
      { title: 'Học hỏi và cải tiến liên tục', text: 'Hiểu biết được cải thiện và sai sót được phát hiện, nên bài viết được sửa đổi. Mỗi lần sửa đổi đáng kể được ghi ngày trên bài viết.' },
      { title: 'Tách bạch kết quả đã xác lập và ý tưởng khám phá', text: 'Kết quả đã được xác lập, cách diễn giải và câu hỏi còn mở được đánh dấu là những thứ khác nhau.' },
    ],
    review: 'Tiêu chuẩn biên tập',
    reviewIntro: 'ACRR tuân theo một bộ tiêu chuẩn biên tập thành văn. Trước khi được đăng, mỗi bài viết, loạt bài hoặc góc nhìn đều qua cùng các bước thẩm định:',
    reviewStages: [
      { title: 'Cấu trúc và lập luận', text: 'mục đích, người đọc hướng tới, trình tự các ý và độ sâu của phần giải thích.' },
      { title: 'Ngôn ngữ', text: 'tiếng Anh (Mỹ) chính xác và nhất quán, mỗi khái niệm một thuật ngữ, không viết thừa.' },
      { title: 'Dữ kiện và nguồn', text: 'các nhận định, ngày tháng, tiêu chuẩn và con số được đối chiếu với nguồn gốc hoặc nguồn có thẩm quyền, và mỗi tài liệu tham khảo được kiểm tra là có thật và thực sự hỗ trợ điều được trích dẫn.' },
      { title: 'Độ chính xác kỹ thuật', text: 'định nghĩa, phép suy dẫn, phương trình và các con số tính toán được kiểm tra lại, mã nguồn được chạy thử khi có thể.' },
      { title: 'Thẩm định loạt bài', text: 'mỗi loạt bài được đọc như một ấn phẩm thống nhất, về trình tự, ký hiệu và các tham chiếu chéo.' },
      { title: 'Kiểm tra xuất bản', text: 'quá trình dựng trang, liên kết, siêu dữ liệu, công thức toán, sơ đồ và khả năng tiếp cận.' },
    ],
    reviewOutro: 'Bước kiểm tra cuối cùng chấm điểm từng mục theo các tiêu chí chấp nhận thành văn. Một mục còn lỗi chưa sửa, có nguồn không kiểm chứng được hoặc có tham chiếu chéo sai sẽ không được đăng, và một nhận định chưa kiểm chứng được sẽ được nói rõ như vậy thay vì trình bày như sự thật. Các tiêu chuẩn này áp dụng cho bản gốc tiếng Anh.',
    direction: 'Định hướng dài hạn',
    directionText: 'ACRR bắt đầu như một nền tảng xuất bản độc lập: bài viết, loạt bài, góc nhìn và một danh mục tài nguyên học tập. Dự định là phát triển nó, từng bước, thành một môi trường nghiên cứu toàn diện hơn, có thể dần hỗ trợ dự án, hợp tác và hoạt động phòng thí nghiệm. Đó là một định hướng, không phải mô tả hiện trạng, và không hàm ý mốc thời gian nào.',
    aboutSite: 'Về nội dung và tác giả',
    contentText: ['Bài viết, loạt bài và góc nhìn được đăng khi đã hoàn chỉnh. Các loạt bài và bài viết chưa được viết được đánh dấu là dự kiến. Mọi nội dung mẫu chỉ nhằm minh họa định dạng đều được đánh dấu', 'Ví dụ', 'và không nên được hiểu là nghiên cứu gốc đã hoàn thành.'],
    languages: 'Bài viết được viết bằng tiếng Anh. Bản dịch tiếng Việt được đăng dưới đường dẫn /vi khi hoàn thành; nếu bản dịch và bản gốc tiếng Anh có khác biệt, bản gốc là bản chuẩn.',
    personal: 'Trang này cố ý không có tiểu sử cá nhân, bằng cấp, đơn vị công tác hay thông tin liên hệ. Thông tin cá nhân chỉ được thêm khi tác giả của trang cung cấp.',
    continueLabel: 'Tiếp tục khám phá',
    continueEyebrow: 'tiếp tục',
    links: [['/blog', 'Đọc bài viết'], ['/series', 'Xem các loạt bài'], ['/insights', 'Xem góc nhìn'], ['/learning', 'Xem tài nguyên học tập']],
  },
}[lang];
---
<Base title={copy.title} description={copy.description} narrow>
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.h1}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <div class="prose">
    <section aria-labelledby="mission">
      <h2 id="mission">{copy.mission}</h2>
      <p>{copy.missionText}</p>
    </section>

    <section aria-labelledby="scope">
      <h2 id="scope">{copy.scope}</h2>
      <p>{copy.scopeText}</p>
      <ul>
        {researchAreas.map((area) => (
          <li><strong>{area.title}.</strong> {area.description}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="principles">
      <h2 id="principles">{copy.principles}</h2>
      <p>{copy.principlesText}</p>
      <ul>
        {copy.principleList.map((p) => (
          <li><strong>{p.title}.</strong> {p.text}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="standards">
      <h2 id="standards">{copy.review}</h2>
      <p>{copy.reviewIntro}</p>
      <ul>
        {copy.reviewStages.map((s) => (
          <li><strong>{s.title}:</strong> {s.text}</li>
        ))}
      </ul>
      <p>{copy.reviewOutro}</p>
    </section>

    <section aria-labelledby="direction">
      <h2 id="direction">{copy.direction}</h2>
      <p>{copy.directionText}</p>
    </section>

    <section aria-labelledby="about-site">
      <h2 id="about-site">{copy.aboutSite}</h2>
      <p>
        {copy.contentText[0]} <span class="badge notice">{copy.contentText[1]}</span> {copy.contentText[2]}
      </p>
      <p>{copy.languages}</p>
      <p>{copy.personal}</p>
    </section>

    <nav class="next" aria-label={copy.continueLabel}>
      <p class="eyebrow">{copy.continueEyebrow}</p>
      <ul>
        {copy.links.map(([path, label]) => <li><a href={href(path)}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .page-head { margin-bottom: var(--space-4); }
  .page-head .eyebrow { margin: 0 0 var(--space-2); }
  .page-head .lede { margin: 0; }

  .prose section:first-child h2 { margin-top: var(--space-4); }
  .prose li { margin-block: 0.5em; }

  .next {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 1rem;
  }
  .next .eyebrow { margin: 0 0 var(--space-2); }
  .next ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .next li { margin: 0; }
  .next a { display: inline-block; padding-block: 0.25rem; }
</style>
