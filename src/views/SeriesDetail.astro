---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { baseId, entryLang, formatDate, getSeriesPosts, hasTranslation, postHref } from '../lib/content';
import { categoryLabel, localizePath, t } from '../i18n/ui';

interface Props { series: CollectionEntry<'series'> }

const { series } = Astro.props;
const { data } = series;
const lang = entryLang(series);
const ui = t(lang);
const id = baseId(series);
const counterpart = lang === 'en' ? ((await hasTranslation('series', id)) ? `/series/${id}` : null) : `/series/${id}`;
const copy = {
  en: {
    all: '← All series',
    start: 'Start with entry 1',
    exampleTitle: 'Example / illustrative series.',
    exampleText: 'This series is sample content that shows how ACRR plans to organize multi-part material. Entries marked “Planned” have not been written, and articles marked “Example” are not completed research.',
    entries: 'Entries',
    notWritten: 'Not written yet.',
    noEntries: 'No entries have been added to this series yet.',
    overview: 'Series overview',
    objectives: 'Learning objectives',
    intended: 'Intended objectives. This series has not started publishing.',
    noObjectives: 'Objectives have not been written yet.',
    progress: 'Progress',
  },
  vi: {
    all: '← Tất cả loạt bài',
    start: 'Bắt đầu từ bài 1',
    exampleTitle: 'Loạt bài ví dụ / minh họa.',
    exampleText: 'Loạt bài này là nội dung mẫu cho thấy ACRR dự định tổ chức nội dung nhiều phần như thế nào. Các mục đánh dấu “Dự kiến” chưa được viết, và các bài đánh dấu “Ví dụ” không phải nghiên cứu đã hoàn thành.',
    entries: 'Các bài',
    notWritten: 'Chưa được viết.',
    noEntries: 'Loạt bài này chưa có bài nào.',
    overview: 'Tổng quan loạt bài',
    objectives: 'Mục tiêu học tập',
    intended: 'Mục tiêu dự kiến. Loạt bài này chưa bắt đầu đăng.',
    noObjectives: 'Chưa có mục tiêu.',
    progress: 'Tiến độ',
  },
}[lang];
const foreignLang = (p: CollectionEntry<'blog'>) => (entryLang(p) !== lang ? 'en' : undefined);

// Optional longer introduction from the Markdown body.
const hasBody = Boolean(series.body?.trim());
const Content = hasBody ? (await render(series)).Content : null;

// Posts come back in reading order. Drafts only exist in `astro dev`; they are shown
// there with a badge but never counted as published.
const posts = await getSeriesPosts(id, lang);
const minutes = await Promise.all(
  posts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    const value = remarkPluginFrontmatter?.minutesRead;
    return typeof value === 'number' && value > 0 ? value : undefined;
  }),
);
const publishedCount = posts.filter((p) => !p.data.draft).length;
const planned = data.plannedEntries;
const total = publishedCount + planned.length;
const percent = total === 0 ? 0 : Math.round((publishedCount / total) * 100);
const progressText = ui.entriesPublished(publishedCount, total);
const firstPost = posts[0];
---
<Base title={data.title} description={data.description} example={data.example ? 'series' : undefined} counterpart={counterpart}>
  <nav class="crumb" aria-label="Breadcrumb"><a href={localizePath('/series', lang)}>{copy.all}</a></nav>

  <header class="head">
    <p class="eyebrow" data-pagefind-ignore>{ui.seriesEyebrow}</p>
    <h1>{data.title}</h1>
    <p class="lede">{data.description}</p>
    <p class="meta" data-pagefind-ignore>
      <span>{categoryLabel(data.category, lang)}</span>
      <StatusBadge status={data.status} />
      {data.example && <span class="badge notice">{ui.example}</span>}
    </p>
    {firstPost && (
      <p class="start" data-pagefind-ignore>
        <a class="btn primary" href={postHref(firstPost)}>{copy.start}</a>
      </p>
    )}
  </header>

  {data.example && (
    <aside class="example-notice" aria-label={copy.exampleTitle}>
      <p><strong>{copy.exampleTitle}</strong> {copy.exampleText}</p>
    </aside>
  )}

  {Content && (
    <div class="prose intro">
      <Content />
    </div>
  )}

  <div class="layout">
    <section class="main" aria-labelledby="entries-heading">
      <h2 id="entries-heading">{copy.entries}</h2>

      {posts.length + planned.length > 0 ? (
        <ol class="entries" role="list">
          {posts.map((post, i) => (
            <li class="entry">
              <span class="step" aria-hidden="true" data-pagefind-ignore>{i + 1}</span>
              <div class="body">
                <p class="meta" data-pagefind-ignore>
                  <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>{formatDate(post.data.publishedAt, lang)}</time>
                  {minutes[i] && <span>{ui.minRead(minutes[i])}</span>}
                  {foreignLang(post) && <span class="badge" lang="en">{ui.inEnglish}</span>}
                  {post.data.example && <span class="badge notice">{ui.example}</span>}
                  {post.data.draft && <span class="badge">{ui.draftDev}</span>}
                </p>
                <h3><a href={postHref(post)} lang={foreignLang(post)}>{post.data.title}</a></h3>
                <p class="entry-desc" lang={foreignLang(post)}>{post.data.description}</p>
                <p class="go" aria-hidden="true" data-pagefind-ignore>{ui.readArticle}</p>
              </div>
            </li>
          ))}
          {planned.map((entry, i) => (
            <li class="entry planned">
              <span class="step" aria-hidden="true" data-pagefind-ignore>{posts.length + i + 1}</span>
              <div class="body">
                <p class="meta" data-pagefind-ignore><StatusBadge status="planned" /></p>
                <h3>{entry.title}</h3>
                {entry.description && <p class="entry-desc">{entry.description}</p>}
                <p class="entry-desc not-written">{copy.notWritten}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="note">{copy.noEntries}</p>
      )}
    </section>

    <aside class="side" aria-label={copy.overview}>
      <section aria-labelledby="objectives-heading">
        <h2 id="objectives-heading">{copy.objectives}</h2>
        {data.status === 'planned' && (
          <p class="note">{copy.intended}</p>
        )}
        {data.objectives.length > 0 ? (
          <ul class="objectives">
            {data.objectives.map((objective) => <li>{objective}</li>)}
          </ul>
        ) : (
          <p class="note">{copy.noObjectives}</p>
        )}
      </section>

      <section class="progress" aria-labelledby="progress-heading" data-pagefind-ignore>
        <h2 id="progress-heading">{copy.progress}</h2>
        <p class="progress-text">{progressText}</p>
        <div class="progress-bar" role="presentation"><span style={`width: ${percent}%`}></span></div>
      </section>
    </aside>
  </div>
</Base>

<style>
  .crumb { margin: 0 0 var(--space-4); font-family: var(--font-mono); font-size: 0.85rem; }
  .crumb a { display: inline-block; padding-block: 0.3rem; }

  .head { margin-bottom: var(--space-4); }
  .head .eyebrow { margin: 0 0 var(--space-2); }
  .head h1 { margin-bottom: var(--space-3); }
  .head .lede { margin: 0; }
  .head .meta { align-items: center; margin-top: var(--space-3); }
  .start { margin: var(--space-4) 0 0; }
  .start .btn { min-height: 2.75rem; display: inline-flex; align-items: center; }
  .start .btn:hover { text-decoration: underline; }

  .example-notice {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
    max-width: var(--measure);
  }
  .example-notice p { margin: 0; }

  .intro { margin-block: var(--space-4); font-size: 1.05rem; }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); margin-top: var(--space-5); }
  .layout h2 { margin-top: 0; font-size: 1.25rem; }
  .note { color: var(--ink-muted); font-style: italic; margin-block: 0 var(--space-3); }

  /* Objectives and progress come first on small screens, beside the entries on wide ones. */
  .side { display: flex; flex-direction: column; gap: var(--space-5); order: -1; }
  .objectives { margin: 0; padding-left: 1.25rem; font-size: 0.95rem; }
  .objectives li { margin-block: var(--space-2); }

  .progress-text {
    margin: 0 0 var(--space-2); font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-muted);
  }
  .progress-bar { height: 6px; background: var(--rule); border-radius: 3px; overflow: hidden; }
  .progress-bar span { display: block; height: 100%; background: var(--accent); }

  .entries { list-style: none; margin: 0; padding: 0; }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-4);
  }
  /* Vertical connector between the numbered steps. */
  .entry:not(:last-child)::before {
    content: '';
    position: absolute; left: calc(1.125rem - 1px); top: 2.25rem; bottom: 0;
    width: 2px; background: var(--rule);
  }
  .step {
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem; border-radius: 50%;
    border: 2px solid var(--accent); color: var(--accent); background: var(--bg);
    font-family: var(--font-mono); font-size: 0.9rem; font-weight: 600;
  }
  .body {
    position: relative;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule); border-radius: 6px; background: var(--bg);
  }
  .entry:not(.planned) .body:hover { border-color: var(--accent); background: var(--bg-subtle); }
  .entry:not(.planned) .body:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .body .meta { align-items: center; margin: 0 0 var(--space-1); }
  .body h3 { font-size: 1.15rem; margin: 0 0 var(--space-1); }
  .body h3 a { color: var(--ink); text-decoration: none; }
  .body h3 a:hover { color: var(--accent); text-decoration: underline; }
  .body h3 a:focus-visible { outline: none; }
  /* The whole card is the click target; the title link stretches over it. */
  .body h3 a::after { content: ''; position: absolute; inset: 0; }
  .entry-desc { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }
  .go { margin: var(--space-2) 0 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); }

  .planned .step { border-style: dashed; border-color: var(--ink-muted); color: var(--ink-muted); }
  .planned .body { border-style: dashed; background: transparent; }
  .planned h3 { color: var(--ink-muted); }
  .not-written { margin-top: var(--space-1); font-style: italic; font-size: 0.85rem; }

  @media (min-width: 56rem) {
    .layout { grid-template-columns: minmax(0, 1fr) 18rem; gap: var(--space-6); align-items: start; }
    .main { grid-column: 1; grid-row: 1; }
    .side { grid-column: 2; grid-row: 1; order: 0; position: sticky; top: var(--space-4); }
  }
</style>
