---
import Base from '../layouts/Base.astro';
import TagNav from '../components/TagNav.astro';
import PostList from '../components/PostList.astro';
import InsightCard from '../components/InsightCard.astro';
import type { TagEntry } from '../lib/content';
import { langFromUrl, localizePath, t } from '../i18n/ui';

interface Props { entry: TagEntry }

const { entry } = Astro.props;
const lang = langFromUrl(Astro.url);
const ui = t(lang);
const summary = [
  entry.posts.length > 0 ? ui.articles(entry.posts.length) : null,
  entry.insights.length > 0 ? ui.insights(entry.insights.length) : null,
]
  .filter(Boolean)
  .join(lang === 'vi' ? ' và ' : ' and ');
const copy = {
  en: {
    title: `${entry.name} · Tags`,
    description: `${summary} tagged "${entry.name}", newest first.`,
    eyebrow: 'tag',
    lede: `${summary} tagged with this topic, newest first.`,
    all: 'All tags',
    articles: 'Articles',
    insights: 'Insights',
  },
  vi: {
    title: `${entry.name} · Thẻ`,
    description: `${summary} gắn thẻ "${entry.name}", mới nhất trước.`,
    eyebrow: 'thẻ',
    lede: `${summary} gắn thẻ chủ đề này, mới nhất trước.`,
    all: 'Tất cả thẻ',
    articles: 'Bài viết',
    insights: 'Góc nhìn',
  },
}[lang];
---
<Base title={copy.title} description={copy.description} searchable={false}>
  <header>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{entry.name}</h1>
    <p class="lede">{copy.lede} <a href={localizePath('/tags', lang)}>{copy.all}</a>.</p>
  </header>

  <TagNav active={entry.slug} />

  {entry.posts.length > 0 && (
    <section aria-labelledby="tag-articles">
      <h2 id="tag-articles" class="group">{copy.articles}</h2>
      <PostList posts={entry.posts} groupByYear={false} />
    </section>
  )}

  {entry.insights.length > 0 && (
    <section aria-labelledby="tag-insights">
      <h2 id="tag-insights" class="group">{copy.insights}</h2>
      <ul class="list">
        {entry.insights.map((insight) => (
          <li><InsightCard insight={insight} level={3} /></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  header { margin-bottom: var(--space-4); }
  .group { font-size: 1.3rem; margin: var(--space-5) 0 var(--space-2); }
</style>
