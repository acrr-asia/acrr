---
import Base from '../layouts/Base.astro';
import CategoryNav from '../components/CategoryNav.astro';
import PostList from '../components/PostList.astro';
import TagNav from '../components/TagNav.astro';
import { getPosts } from '../lib/content';
import { langFromUrl } from '../i18n/ui';

const lang = langFromUrl(Astro.url);
const posts = await getPosts(lang);
const copy = {
  en: {
    title: 'Blog',
    description: 'A chronological archive of technical articles, research notes, tutorials and engineering write-ups from ACRR.',
    eyebrow: 'blog',
    lede: 'Technical articles, research notes, tutorials and engineering write-ups, newest first.',
  },
  vi: {
    title: 'Bài viết',
    description: 'Kho lưu trữ theo thời gian các bài viết kỹ thuật, ghi chú nghiên cứu, hướng dẫn và bài phân tích kỹ thuật của ACRR.',
    eyebrow: 'bài viết',
    lede: 'Bài viết kỹ thuật, ghi chú nghiên cứu, hướng dẫn và bài phân tích kỹ thuật, mới nhất trước.',
  },
}[lang];
---
<Base title={copy.title} description={copy.description} searchable={false}>
  <header>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="lede">{copy.lede}</p>
  </header>
  <CategoryNav />
  <TagNav scope="posts" />
  <PostList posts={posts} />
</Base>
