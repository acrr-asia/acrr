---
import Base from '../layouts/Base.astro';
import CategoryNav from '../components/CategoryNav.astro';
import PostList from '../components/PostList.astro';
import type { CollectionEntry } from 'astro:content';
import { categoryLabel, langFromUrl, localizePath, t } from '../i18n/ui';

interface Props { category: string; posts: CollectionEntry<'blog'>[] }

const { category, posts } = Astro.props;
const count = posts.length;
const lang = langFromUrl(Astro.url);
const name = categoryLabel(category, lang);
const copy = {
  en: {
    title: `${name} · Blog`,
    description: `Articles in the ${name} category: ${t('en').articles(count)}, newest first.`,
    eyebrow: 'category',
    lede: `${t('en').articles(count)} in this category, newest first.`,
    back: 'Back to all articles',
  },
  vi: {
    title: `${name} · Bài viết`,
    description: `Các bài viết thuộc chuyên mục ${name}: ${t('vi').articles(count)}, mới nhất trước.`,
    eyebrow: 'chuyên mục',
    lede: `${t('vi').articles(count)} trong chuyên mục này, mới nhất trước.`,
    back: 'Xem tất cả bài viết',
  },
}[lang];
---
<Base title={copy.title} description={copy.description} searchable={false}>
  <header>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{name}</h1>
    <p class="lede">
      {copy.lede}{' '}
      <a href={localizePath('/blog', lang)}>{copy.back}</a>.
    </p>
  </header>
  <CategoryNav active={category} />
  <PostList posts={posts} />
</Base>
