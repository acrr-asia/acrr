---
import Base from '../layouts/Base.astro';
import InsightCard from '../components/InsightCard.astro';
import TagNav from '../components/TagNav.astro';
import { entryLang, getInsights } from '../lib/content';
import { langFromUrl, t } from '../i18n/ui';

const lang = langFromUrl(Astro.url);
const insights = await getInsights(lang);
const hasExamples = insights.some((i) => i.data.example);
const hasForeign = insights.some((i) => entryLang(i) !== lang);
const copy = {
  en: {
    title: 'Insights',
    description: 'Short technical perspectives on advanced computing and robotics that separate what is established from interpretation and from open questions.',
    eyebrow: 'advanced computing & robotics',
    lede: 'Short perspectives on advanced computing and robotics: concept explanations, comparisons of technical approaches, methodological notes, and open questions. Each one keeps three things apart: what is established, how it is interpreted, and what remains open.',
    exampleTitle: 'Example insights.',
    exampleText: 'Entries marked “Example” are sample content that demonstrates the format. They are not research results.',
    empty: 'No insights have been published yet.',
    foreign: '',
  },
  vi: {
    title: 'Góc nhìn',
    description: 'Những góc nhìn kỹ thuật ngắn về điện toán tiên tiến và robot, tách bạch điều đã được xác lập, cách diễn giải và các câu hỏi còn mở.',
    eyebrow: 'điện toán tiên tiến & robot',
    lede: 'Những góc nhìn ngắn về điện toán tiên tiến và robot: giải thích khái niệm, so sánh các cách tiếp cận kỹ thuật, ghi chú phương pháp và câu hỏi còn mở. Mỗi bài tách bạch ba điều: điều đã được xác lập, cách diễn giải, và điều còn bỏ ngỏ.',
    exampleTitle: 'Góc nhìn ví dụ.',
    exampleText: 'Các mục đánh dấu “Ví dụ” là nội dung mẫu minh họa định dạng, không phải kết quả nghiên cứu.',
    empty: 'Chưa có góc nhìn nào được đăng.',
    foreign: t('vi').untranslatedNote,
  },
}[lang];
---
<Base title={copy.title} description={copy.description} searchable={false}>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.title}</h1>
  <p class="lede">{copy.lede}</p>

  {hasExamples && (
    <aside class="example-notice" aria-label={copy.exampleTitle}>
      <p><strong>{copy.exampleTitle}</strong> {copy.exampleText}</p>
    </aside>
  )}
  {hasForeign && copy.foreign && (
    <aside class="example-notice"><p>{copy.foreign}</p></aside>
  )}

  <TagNav scope="insights" />

  {insights.length > 0 ? (
    <ul class="list">
      {insights.map((insight) => (
        <li><InsightCard insight={insight} level={2} /></li>
      ))}
    </ul>
  ) : (
    <p>{copy.empty}</p>
  )}
</Base>

<style>
  .example-notice {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    max-width: var(--measure);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
  }
  .example-notice p { margin: 0; }
  .list { margin-top: var(--space-4); }
</style>
