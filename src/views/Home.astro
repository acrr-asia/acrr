---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import SectionHead from '../components/home/SectionHead.astro';
import ResearchAreas from '../components/home/ResearchAreas.astro';
import ExploreMenu from '../components/home/ExploreMenu.astro';
import { baseId, getInsights, getPosts, getSeriesList, getSeriesPosts } from '../lib/content';
import { langFromUrl, localizePath } from '../i18n/ui';

const lang = langFromUrl(Astro.url);
const href = (path: string) => localizePath(path, lang);

// Featured publications: the latest three posts. Drafts are excluded in production by getPosts().
const posts = await getPosts(lang);
const featured = posts.slice(0, 3);
const articleCount = posts.length;
const insightCount = (await getInsights(lang)).length;
const featuredAreExamples = featured.length > 0 && featured.every((p) => p.data.example);

// Research series, each with the number of its published articles.
const seriesList = await getSeriesList(lang);
const seriesWithCounts = await Promise.all(
  seriesList.map(async (series) => ({ series, count: (await getSeriesPosts(baseId(series), lang)).length })),
);

// Learning resources: summary computed from the real data file.
const learning = await getCollection('learning');
const topicOf = (e: (typeof learning)[number]) => (lang === 'vi' ? (e.data.vi?.topic ?? e.data.topic) : e.data.topic);
const learningTopics = [...new Set(learning.map(topicOf))].sort((a, b) => a.localeCompare(b, lang));
const learningWithLink = learning.filter((e) => e.data.url).length;

const copy = {
  en: {
    description: 'ACRR is an independent technical publication on computing, control, robotics and the engineering methods that connect them.',
    heroEyebrow: 'independent research publishing',
    heroTitle: 'Advanced Computing & Robotics Research',
    heroLede: 'ACRR is an independent research and technical publication. It publishes long-form articles, organized into series that teach a subject in order, and short insights that keep established results apart from interpretation and open questions.',
    explore: 'Explore Research',
    browseLearning: 'Browse Learning Resources',
    heroNote: (articles: number, series: number, insights: number) => `ACRR is at an early stage. It currently publishes ${articles} ${articles === 1 ? 'article' : 'articles'}, ${series} series and ${insights} ${insights === 1 ? 'insight' : 'insights'}, each reviewed against the same editorial standards before publication.`,
    areasEyebrow: 'research areas',
    areasTitle: 'Proposed areas of interest',
    areasIntro: 'These are the fields ACRR proposes to study. They describe where attention is intended to go, not active projects or a staffed laboratory in each area.',
    featuredEyebrow: 'featured publications',
    featuredTitle: 'Latest articles',
    allArticles: 'All articles',
    featuredExamples: ['The articles shown here are sample content, marked', 'They illustrate the format and are not completed original research.'],
    noArticles: 'No articles have been published yet. New articles will appear here as they are published.',
    seriesEyebrow: 'research series',
    seriesTitle: 'Structured sequences',
    allSeries: 'All series',
    seriesIntro: 'A series arranges related articles in a reading order. A series marked as planned or in progress also lists the entries that are intended but not yet written.',
    noSeries: 'No series are listed yet.',
    learningEyebrow: 'learning resources',
    learningTitle: 'Learning paths and references',
    learningIntro: ['ACRR intends to curate learning paths, study notes and external references. These are still being organized: until a real page exists for an entry, it is marked', 'Coming soon', 'and carries no link.'],
    topicsSoFar: 'Topics listed so far:',
    entriesListed: (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'} listed`,
    withLink: (n: number) => `${n} with a public link`,
    noLearning: 'No learning resources are listed yet.',
    directionEyebrow: 'platform direction',
    directionTitle: 'From publishing platform to research environment',
    aboutAcrr: 'About ACRR',
    directionIntro: 'ACRR is intended to grow from an independent publication into a broader research environment. Today it is at the first stage: publishing technical writing and organizing it into series. This describes a direction, not a current capability, and no timeline is implied.',
    stage: (n: number) => `Stage ${n}`,
    stages: [
      { title: 'Publish', badge: 'Current focus', text: 'Technical articles, research notes and insights, written so that the reasoning and the assumptions are visible, not only the conclusions.' },
      { title: 'Organize', badge: 'In progress', text: 'Series that connect individual articles into a route through a subject, and learning paths that connect the series. The series are published; the learning paths are planned.' },
      { title: 'Collaborate', badge: 'Intended', text: 'Projects, collaboration and laboratory activities, if and when there is real work and real people behind them.' },
    ],
    navEyebrow: 'navigate',
    navTitle: 'Explore ACRR',
  },
  vi: {
    description: 'ACRR là một ấn phẩm kỹ thuật độc lập về điện toán, điều khiển, robot và các phương pháp kỹ thuật kết nối chúng.',
    heroEyebrow: 'xuất bản nghiên cứu độc lập',
    heroTitle: 'Nghiên cứu Điện toán Tiên tiến & Robot',
    heroLede: 'ACRR là một ấn phẩm độc lập về nghiên cứu và kỹ thuật. ACRR đăng các bài viết chuyên sâu, được sắp xếp thành các loạt bài để học một chủ đề theo trình tự, cùng các góc nhìn ngắn tách bạch kết quả đã được xác lập với cách diễn giải và câu hỏi còn mở.',
    explore: 'Khám phá nghiên cứu',
    browseLearning: 'Xem tài nguyên học tập',
    heroNote: (articles: number, series: number, insights: number) => `ACRR đang ở giai đoạn đầu. Hiện có ${articles} bài viết, ${series} loạt bài và ${insights} góc nhìn, tất cả đều được thẩm định theo cùng một bộ tiêu chuẩn biên tập trước khi đăng.`,
    areasEyebrow: 'lĩnh vực nghiên cứu',
    areasTitle: 'Các lĩnh vực quan tâm đề xuất',
    areasIntro: 'Đây là những lĩnh vực ACRR đề xuất tìm hiểu. Chúng cho biết sự quan tâm dự định hướng tới đâu, không phải các dự án đang triển khai hay một phòng thí nghiệm có nhân sự trong từng lĩnh vực.',
    featuredEyebrow: 'bài viết nổi bật',
    featuredTitle: 'Bài viết mới nhất',
    allArticles: 'Tất cả bài viết',
    featuredExamples: ['Các bài viết hiển thị ở đây là nội dung mẫu, được đánh dấu', 'Chúng minh họa định dạng và không phải nghiên cứu gốc đã hoàn thành.'],
    noArticles: 'Chưa có bài viết nào được đăng. Bài viết mới sẽ xuất hiện ở đây khi được đăng.',
    seriesEyebrow: 'loạt bài nghiên cứu',
    seriesTitle: 'Lộ trình có cấu trúc',
    allSeries: 'Tất cả loạt bài',
    seriesIntro: 'Một loạt bài sắp xếp các bài viết liên quan theo thứ tự đọc. Loạt bài được đánh dấu dự kiến hoặc đang viết cũng liệt kê các bài dự định nhưng chưa viết.',
    noSeries: 'Chưa có loạt bài nào.',
    learningEyebrow: 'tài nguyên học tập',
    learningTitle: 'Lộ trình học và tài liệu tham khảo',
    learningIntro: ['ACRR dự định tuyển chọn các lộ trình học, ghi chú học tập và tài liệu tham khảo bên ngoài. Các mục này vẫn đang được sắp xếp: chừng nào một mục chưa có trang thật, mục đó được đánh dấu', 'Sắp ra mắt', 'và không có liên kết.'],
    topicsSoFar: 'Các chủ đề hiện có:',
    entriesListed: (n: number) => `${n} mục`,
    withLink: (n: number) => `${n} mục có liên kết công khai`,
    noLearning: 'Chưa có tài nguyên học tập nào.',
    directionEyebrow: 'định hướng nền tảng',
    directionTitle: 'Từ nền tảng xuất bản đến môi trường nghiên cứu',
    aboutAcrr: 'Giới thiệu ACRR',
    directionIntro: 'ACRR dự định phát triển từ một ấn phẩm độc lập thành một môi trường nghiên cứu rộng hơn. Hiện nay ACRR ở giai đoạn đầu: đăng các bài viết kỹ thuật và sắp xếp chúng thành các loạt bài. Đây là một định hướng, không phải năng lực hiện có, và không hàm ý mốc thời gian nào.',
    stage: (n: number) => `Giai đoạn ${n}`,
    stages: [
      { title: 'Xuất bản', badge: 'Trọng tâm hiện tại', text: 'Bài viết kỹ thuật, ghi chú nghiên cứu và góc nhìn, được viết sao cho lập luận và giả định đều rõ ràng, không chỉ kết luận.' },
      { title: 'Tổ chức', badge: 'Đang thực hiện', text: 'Các loạt bài nối những bài viết riêng lẻ thành một lộ trình qua một chủ đề, và các lộ trình học nối các loạt bài với nhau. Các loạt bài đã được đăng; các lộ trình học vẫn đang dự kiến.' },
      { title: 'Hợp tác', badge: 'Dự định', text: 'Dự án, hợp tác và hoạt động phòng thí nghiệm, nếu và khi có công việc thật và con người thật đứng sau.' },
    ],
    navEyebrow: 'điều hướng',
    navTitle: 'Khám phá ACRR',
  },
}[lang];
---
<Base title="ACRR" description={copy.description} searchable={false}>
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">{copy.heroEyebrow}</p>
    <h1 id="hero-title">{copy.heroTitle}</h1>
    <p class="lede">{copy.heroLede}</p>
    <p class="actions">
      <a class="btn primary" href={href('/blog')}>{copy.explore}</a>
      <a class="btn" href={href('/learning')}>{copy.browseLearning}</a>
    </p>
    <p class="note">{copy.heroNote(articleCount, seriesList.length, insightCount)}</p>
  </section>

  <section class="block" aria-labelledby="areas-title">
    <SectionHead id="areas-title" eyebrow={copy.areasEyebrow} title={copy.areasTitle} />
    <p class="intro">{copy.areasIntro}</p>
    <ResearchAreas />
  </section>

  <section class="block" aria-labelledby="featured-title">
    <SectionHead
      id="featured-title"
      eyebrow={copy.featuredEyebrow}
      title={copy.featuredTitle}
      href={href('/blog')}
      linkLabel={copy.allArticles}
    />
    {featured.length > 0 ? (
      <>
        {featuredAreExamples && (
          <p class="intro">
            {copy.featuredExamples[0]} <span class="badge notice">{lang === 'vi' ? 'Ví dụ' : 'Example'}</span>.{' '}
            {copy.featuredExamples[1]}
          </p>
        )}
        <ul class="list">
          {featured.map((post) => (
            <li><PostCard post={post} /></li>
          ))}
        </ul>
      </>
    ) : (
      <p class="empty">{copy.noArticles}</p>
    )}
  </section>

  <section class="block" aria-labelledby="series-title">
    <SectionHead
      id="series-title"
      eyebrow={copy.seriesEyebrow}
      title={copy.seriesTitle}
      href={href('/series')}
      linkLabel={copy.allSeries}
    />
    <p class="intro">{copy.seriesIntro}</p>
    {seriesWithCounts.length > 0 ? (
      <ul class="grid">
        {seriesWithCounts.map(({ series, count }) => (
          <li><SeriesCard series={series} count={count} /></li>
        ))}
      </ul>
    ) : (
      <p class="empty">{copy.noSeries}</p>
    )}
  </section>

  <section class="block" aria-labelledby="learning-title">
    <SectionHead
      id="learning-title"
      eyebrow={copy.learningEyebrow}
      title={copy.learningTitle}
      href={href('/learning')}
      linkLabel={copy.browseLearning}
    />
    <p class="intro">
      {copy.learningIntro[0]}{' '}<strong>{copy.learningIntro[1]}</strong>{' '}{copy.learningIntro[2]}
    </p>
    {learning.length > 0 ? (
      <>
        <p class="topics">
          <span class="label">{copy.topicsSoFar}</span> {learningTopics.join(' · ')}
        </p>
        <p class="meta">
          <span>{copy.entriesListed(learning.length)}</span>
          <span>{copy.withLink(learningWithLink)}</span>
        </p>
      </>
    ) : (
      <p class="empty">{copy.noLearning}</p>
    )}
  </section>

  <section class="block" aria-labelledby="direction-title">
    <SectionHead
      id="direction-title"
      eyebrow={copy.directionEyebrow}
      title={copy.directionTitle}
      href={href('/about')}
      linkLabel={copy.aboutAcrr}
    />
    <p class="intro">{copy.directionIntro}</p>
    <ol class="grid stages">
      {copy.stages.map((stage, i) => (
        <li>
          <p class="meta">
            <span>{copy.stage(i + 1)}</span>
            <span class:list={['badge', { notice: i === 0 }]}>{stage.badge}</span>
          </p>
          <h3>{stage.title}</h3>
          <p>{stage.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="block" aria-labelledby="explore-title">
    <SectionHead id="explore-title" eyebrow={copy.navEyebrow} title={copy.navTitle} />
    <ExploreMenu />
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-5) var(--space-6); }
  .hero .eyebrow { margin: 0 0 var(--space-3); }
  .hero h1 {
    font-size: clamp(2.1rem, 6vw, 3.4rem);
    line-height: 1.1;
    max-width: 18em;
    margin-bottom: var(--space-4);
  }
  .hero .lede { font-size: 1.2rem; margin: 0 0 var(--space-4); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: 0 0 var(--space-4); }
  .actions .btn { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .actions .btn:not(.primary):hover { background: var(--bg-subtle); }
  .actions .btn.primary:hover { text-decoration: underline; }
  .note { margin: 0; font-size: 0.9rem; color: var(--ink-muted); max-width: var(--measure); }

  .block { border-top: 1px solid var(--rule); padding-block: var(--space-5); }
  .intro { max-width: var(--measure); margin: 0 0 var(--space-4); color: var(--ink-muted); }
  .empty {
    max-width: var(--measure);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--rule);
    border-radius: 4px;
    color: var(--ink-muted);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4) var(--space-5);
  }
  .grid > li { border-top: 1px solid var(--rule); padding-top: var(--space-3); min-width: 0; }
  .stages h3 { font-size: 1.15rem; margin: var(--space-2) 0 var(--space-2); }
  .stages p:not(.meta) { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }

  .topics { margin: 0 0 var(--space-3); max-width: var(--measure); }
  .topics .label { color: var(--ink-muted); }
</style>
