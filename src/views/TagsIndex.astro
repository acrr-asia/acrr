---
import Base from '../layouts/Base.astro';
import { getTagIndex } from '../lib/content';
import { langFromUrl, localizePath, t } from '../i18n/ui';

const lang = langFromUrl(Astro.url);
const ui = t(lang);
const tags = await getTagIndex(lang);
const copy = {
  en: {
    title: 'Tags',
    description: 'Every topic tag used on ACRR, with the number of articles and insights that carry it.',
    eyebrow: 'tags',
    lede: 'Topics that run across articles and insights. The number beside each tag is how many entries carry it.',
    empty: 'No tags yet. Tags appear here once an article or insight uses them.',
  },
  vi: {
    title: 'Thẻ',
    description: 'Tất cả các thẻ chủ đề dùng trên ACRR, kèm số bài viết và góc nhìn mang thẻ đó.',
    eyebrow: 'thẻ',
    lede: 'Các chủ đề xuyên suốt bài viết và góc nhìn. Con số bên cạnh mỗi thẻ là số mục mang thẻ đó. Tên thẻ giữ nguyên tiếng Anh.',
    empty: 'Chưa có thẻ nào. Thẻ xuất hiện ở đây khi có bài viết hoặc góc nhìn sử dụng.',
  },
}[lang];
---
<Base title={copy.title} description={copy.description} searchable={false}>
  <header>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  {tags.length > 0 ? (
    <ul class="tag-list">
      {tags.map((t) => (
        <li>
          <a href={localizePath(`/tags/${t.slug}`, lang)}>
            <span class="name">{t.name}</span>
            <span class="count">{t.count}</span>
            <span class="sr-only">
              ({ui.articles(t.posts.length)}, {ui.insights(t.insights.length)})
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{copy.empty}</p>
  )}
</Base>

<style>
  header { margin-bottom: var(--space-4); }
  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
  }
  .tag-list a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .tag-list a:hover { border-color: var(--accent); color: var(--accent); }
  .count { color: var(--ink-muted); font-size: 0.8rem; }
  .empty { color: var(--ink-muted); }
</style>
