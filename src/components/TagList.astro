---
import { tagSlug } from '../lib/content';

interface Props {
  tags: string[];
}
const tags = Astro.props.tags.filter((t) => t.trim() !== '');
---
{tags.length > 0 && (
  <ul class="tags" aria-label="Tags">
    {tags.map((tag) => (
      <li><a class="badge" href={`/tags/${tagSlug(tag)}`}>{tag}</a></li>
    ))}
  </ul>
)}

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
  }
</style>
