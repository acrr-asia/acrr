---
import { tagSlug } from '../lib/content';
import { langFromUrl, localizePath, t } from '../i18n/ui';

interface Props {
  tags: string[];
}
const tags = Astro.props.tags.filter((tag) => tag.trim() !== '');
const lang = langFromUrl(Astro.url);
---
{tags.length > 0 && (
  <ul class="tags" aria-label={t(lang).tags}>
    {tags.map((tag) => (
      <li><a class="badge" href={localizePath(`/tags/${tagSlug(tag)}`, lang)}>{tag}</a></li>
    ))}
  </ul>
)}

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
  }
</style>
