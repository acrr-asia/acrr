---
import { researchAreas } from './research-areas';
---
<ol class="areas">
  {researchAreas.map((area, i) => (
    <li>
      <span class="index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3>{area.title}</h3>
      <p>{area.description}</p>
    </li>
  ))}
</ol>

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4) var(--space-5);
  }
  li { border-top: 1px solid var(--rule); padding-top: var(--space-3); }
  .index { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-muted); }
  h3 { font-size: 1.15rem; margin: var(--space-1) 0 var(--space-2); }
  p { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }
</style>
