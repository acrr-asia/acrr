---
const sections = [
  { href: '/blog', title: 'Blog', text: 'Articles, research notes and tutorials, newest first.' },
  { href: '/series', title: 'Series', text: 'Related articles arranged in a reading order.' },
  { href: '/learning', title: 'Learning', text: 'An index of planned learning paths, study notes and references, still being organised.' },
  { href: '/insights', title: 'Insights', text: 'Short perspectives on advanced computing and robotics.' },
  { href: '/about', title: 'About', text: 'What ACRR is for, and how it intends to work.' },
];
---
<ul class="explore">
  {sections.map((s) => (
    <li>
      <a href={s.href}>
        <span class="title">{s.title} <span aria-hidden="true">→</span></span>
        <span class="text">{s.text}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .explore {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-3);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
  }
  a:hover { border-color: var(--accent); background: var(--bg-subtle); }
  .title { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; }
  a:hover .title { color: var(--accent); }
  .text { color: var(--ink-muted); font-size: 0.9rem; }
</style>
