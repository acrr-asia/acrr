---
import { getPosts, slugify } from '../lib/content';

interface Props {
  /** Category name currently being viewed; omit on the main archive. */
  active?: string;
}

const { active } = Astro.props;
const posts = await getPosts();

// Only categories that have at least one listed article are linked,
// so no link leads to an empty page.
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const categories = [...counts].sort(([a], [b]) => a.localeCompare(b));
---
{categories.length > 0 && (
  <nav class="category-nav" aria-label="Article categories">
    <ul>
      <li>
        <a href="/blog" aria-current={active ? undefined : 'page'}>All <span class="count">{posts.length}</span></a>
      </li>
      {categories.map(([name, count]) => (
        <li>
          <a href={`/blog/category/${slugify(name)}`} aria-current={active === name ? 'page' : undefined}>
            {name} <span class="count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .category-nav {
    margin: var(--space-4) 0 var(--space-3);
    padding-block: var(--space-2);
    border-block: 1px solid var(--rule);
  }
  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  a:hover { border-color: var(--rule); }
  a[aria-current='page'] { border-color: var(--accent); font-weight: 600; }
  .count { color: var(--ink-muted); }
</style>
