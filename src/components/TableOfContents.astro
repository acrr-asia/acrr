---
/**
 * "Contents" aside for long articles: links to the h2/h3 headings of the rendered Markdown
 * (`headings` comes from `render()` in astro:content). Hidden when there is nothing to navigate.
 *
 * Wide screens: always open, sticky beside the article (placed by the parent grid via `.toc`).
 * Narrow screens: a collapsed <details> disclosure above the text. Without JavaScript it stays
 * open, so the links are never lost.
 */
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[] }

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 1 && (
  <aside class="toc" aria-label="Contents" data-pagefind-ignore>
    <details open>
      <summary>Contents</summary>
      <nav aria-label="Table of contents">
        <ol>
          {items.map((h) => (
            <li class:list={[`depth-${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}

<script>
  const aside = document.querySelector<HTMLElement>('aside.toc');
  const details = aside?.querySelector('details');
  if (aside && details) {
    // Wide: keep it open and non-collapsible. Narrow: collapsed until asked for.
    const wide = window.matchMedia('(min-width: 64rem)');
    const sync = () => { details.open = wide.matches; };
    sync();
    wide.addEventListener('change', sync);

    // Mark the section being read.
    const links = new Map<string, HTMLAnchorElement>();
    aside.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      links.set(decodeURIComponent(a.getAttribute('href')!.slice(1)), a);
    });
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if ('IntersectionObserver' in window && headings.length > 0) {
      const visible = new Set<string>();
      const setCurrent = () => {
        const current = headings.find((h) => visible.has(h.id));
        links.forEach((a, id) => {
          if (current && current.id === id) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      };
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target.id);
            else visible.delete(e.target.id);
          }
          setCurrent();
        },
        { rootMargin: '0px 0px -65% 0px' },
      );
      headings.forEach((h) => observer.observe(h));
    }
  }
</script>

<style>
  .toc { font-family: var(--font-sans); font-size: 0.875rem; }
  summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
    padding-block: var(--space-2);
  }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  ol { list-style: none; margin: var(--space-2) 0 0; padding: 0; border-left: 1px solid var(--rule); }
  li { margin: 0; }
  li a {
    display: block;
    padding: 0.3rem 0 0.3rem var(--space-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-muted);
    text-decoration: none;
    line-height: 1.35;
  }
  li.depth-3 a { padding-left: var(--space-4); font-size: 0.82rem; }
  li a:hover { color: var(--ink); }
  li a[aria-current='location'] { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }

  @media (min-width: 64rem) {
    .toc {
      grid-column: 2;
      grid-row: 1 / span 99;
      align-self: start;
      position: sticky;
      top: var(--space-4);
      max-height: calc(100vh - 2 * var(--space-4));
      overflow-y: auto;
    }
    summary { pointer-events: none; list-style: none; }
    summary::-webkit-details-marker { display: none; }
  }
  @media (max-width: 63.99rem) {
    .toc { margin: 0 0 var(--space-4); border: 1px solid var(--rule); border-radius: 4px; padding: 0 var(--space-3) var(--space-2); background: var(--bg-subtle); }
  }
</style>
