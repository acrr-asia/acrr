---
/**
 * "Contents" for long articles: links to the h2/h3 headings of the rendered Markdown
 * (`headings` comes from `render()` in astro:content). Hidden when there is nothing to navigate.
 *
 * Wide screens (>= 64rem): always open, sticky beside the article (placed by the parent grid).
 * Narrow screens: a slim bar pinned to the top of the viewport while the article is read. It shows
 * the section being read and a reading-progress line; tapping it opens the full list as a dropdown
 * over the text, and choosing a section (or Esc, or tapping outside) closes it again.
 * The pinned bar is switched on by the script (`.enhanced`). Without JavaScript the list is a plain
 * open box above the text, so the links are never lost.
 */
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[] }

import { langFromUrl, t } from '../i18n/ui';

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
const ui = t(langFromUrl(Astro.url));
---
{items.length > 1 && (
  <aside class="toc" aria-label={ui.contents} data-pagefind-ignore>
    <details open>
      <summary>
        <span class="toc-label">{ui.contents}</span>
        <span class="toc-current" data-toc-current></span>
      </summary>
      <nav aria-label={ui.tableOfContents}>
        <ol>
          {items.map((h) => (
            <li class:list={[`depth-${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    </details>
    <div class="toc-progress" aria-hidden="true"><span data-toc-progress></span></div>
  </aside>
)}

<script>
  const aside = document.querySelector<HTMLElement>('aside.toc');
  const details = aside?.querySelector('details');
  if (aside && details) {
    aside.classList.add('enhanced');
    const summary = details.querySelector('summary')!;
    const currentLabel = aside.querySelector<HTMLElement>('[data-toc-current]')!;
    const progress = aside.querySelector<HTMLElement>('[data-toc-progress]')!;
    const prose = document.querySelector<HTMLElement>('.article .prose');

    // Wide: always open and non-collapsible. Narrow: closed until asked for.
    const wide = window.matchMedia('(min-width: 64rem)');
    const sync = () => { details.open = wide.matches; };
    sync();
    wide.addEventListener('change', sync);

    const links = [...aside.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links
      .map((a) => ({ a, h: document.getElementById(decodeURIComponent(a.getAttribute('href')!.slice(1))) }))
      .filter((t): t is { a: HTMLAnchorElement; h: HTMLElement } => t.h !== null);

    // The section being read is the last heading that has scrolled above a line just below the
    // pinned bar (or near the top of the window on wide screens).
    let current: HTMLAnchorElement | undefined;
    const update = () => {
      const line = wide.matches ? window.innerHeight * 0.3 : aside.getBoundingClientRect().bottom + 24;
      let next: HTMLAnchorElement | undefined;
      for (const t of targets) {
        if (t.h.getBoundingClientRect().top <= line) next = t.a;
        else break;
      }
      if (next !== current) {
        current?.removeAttribute('aria-current');
        next?.setAttribute('aria-current', 'location');
        current = next;
        currentLabel.textContent = next ? next.textContent : '';
      }
      if (prose) {
        const r = prose.getBoundingClientRect();
        const total = r.height - window.innerHeight * 0.5;
        const done = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
        progress.style.transform = `scaleX(${done})`;
      }
    };
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();

    // Narrow screens: the open list is a dropdown, so close it after navigating or dismissing.
    const close = (focusSummary = false) => {
      if (wide.matches || !details.open) return;
      details.open = false;
      if (focusSummary) summary.focus();
    };
    links.forEach((a) => a.addEventListener('click', () => close()));
    details.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); close(true); }
    });
    document.addEventListener('click', (e) => {
      if (!aside.contains(e.target as Node)) close();
    });
    // Opening the list scrolls the current section into view inside it.
    details.addEventListener('toggle', () => {
      if (details.open && !wide.matches) current?.scrollIntoView({ block: 'nearest' });
    });
  }
</script>

<style>
  .toc { font-family: var(--font-sans); font-size: 0.875rem; }
  summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
    padding-block: var(--space-2);
  }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .toc-current { display: none; }
  .toc-progress { display: none; }
  ol { list-style: none; margin: var(--space-2) 0 0; padding: 0; border-left: 1px solid var(--rule); }
  li { margin: 0; }
  li a {
    display: block;
    padding: 0.3rem 0 0.3rem var(--space-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-muted);
    text-decoration: none;
    line-height: 1.35;
  }
  li.depth-3 a { padding-left: var(--space-4); font-size: 0.82rem; }
  li a:hover { color: var(--ink); }
  li a[aria-current='location'] { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }

  @media (min-width: 64rem) {
    .toc {
      grid-column: 2;
      grid-row: 1 / span 99;
      align-self: start;
      position: sticky;
      top: var(--space-4);
      max-height: calc(100vh - 2 * var(--space-4));
      overflow-y: auto;
    }
    summary { pointer-events: none; list-style: none; }
    summary::-webkit-details-marker { display: none; }
  }

  @media (max-width: 63.99rem) {
    /* Without JavaScript: a plain open box above the text. */
    .toc { margin: 0 0 var(--space-4); border: 1px solid var(--rule); border-radius: 4px; padding: 0 var(--space-3) var(--space-2); background: var(--bg-subtle); }

    /* With JavaScript: a bar pinned to the top of the window, full width of the page gutter. */
    .toc.enhanced {
      position: sticky;
      top: 0;
      z-index: 20;
      margin: 0 calc(-1 * var(--gutter)) var(--space-4);
      padding: 0 var(--gutter);
      border: 0;
      border-bottom: 1px solid var(--rule);
      border-radius: 0;
      background: var(--bg);
    }
    .enhanced details { position: relative; }
    .enhanced summary {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 2.75rem;
      padding-block: 0;
      list-style: none;
    }
    .enhanced summary::-webkit-details-marker { display: none; }
    .enhanced summary::after {
      content: '▾';
      margin-left: auto;
      padding-left: var(--space-2);
      color: var(--ink-muted);
      font-family: var(--font-sans);
    }
    .enhanced details[open] summary::after { content: '▴'; }
    .enhanced .toc-label { flex: none; }
    .enhanced .toc-current {
      display: block;
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--ink);
      font-family: var(--font-sans);
      font-size: 0.875rem;
    }
    .enhanced .toc-current:not(:empty)::before { content: '· '; color: var(--ink-muted); }
    .enhanced nav {
      position: absolute;
      top: 100%;
      left: calc(-1 * var(--gutter));
      right: calc(-1 * var(--gutter));
      max-height: min(70vh, 32rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-2) var(--gutter) var(--space-3);
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
    }
    .enhanced ol { margin-top: 0; }
    .enhanced li a { padding-block: 0.55rem; }
    .enhanced .toc-progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
    }
    .enhanced .toc-progress span {
      display: block;
      height: 100%;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
    }
  }
</style>
