// Generated diagram (inline SVG). Colours come from CSS tokens via the classes styled in
// src/styles/prose.css (.diagram), so it follows light and dark mode.
---
<svg class="diagram-svg" viewBox="0 0 560 145" role="img" aria-labelledby="proportionalloop-title proportionalloop-desc" data-pagefind-ignore>
  <title id="proportionalloop-title">Proportional feedback around a first-order plant</title>
  <desc id="proportionalloop-desc">The output x is subtracted from the reference r. The error is multiplied by the gain k to give the input u, which drives the plant x-dot equals minus a x plus b u.</desc>
  <defs>
    <marker id="proportionalloop-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="arrowhead" d="M0,0 L10,5 L0,10 z" />
    </marker>
  </defs>
  <text x="14.0" y="52.0" text-anchor="start"><tspan class="var">r</tspan></text>
  <path class="ln" d="M14.0,60.0 L77.0,60.0" marker-end="url(#proportionalloop-arrow)" />
  <circle class="box" cx="90" cy="60" r="13" />
  <path class="ln" d="M84.0,60.0 L96.0,60.0" />
  <path class="ln" d="M90.0,54.0 L90.0,66.0" />
  <text class="sign" x="96.0" y="90.0" text-anchor="start">−</text>
  <path class="ln" d="M103.0,60.0 L160.0,60.0" marker-end="url(#proportionalloop-arrow)" />
  <text class="small" x="131.0" y="52.0" text-anchor="middle"><tspan class="var">r</tspan> − <tspan class="var">x</tspan></text>
  <rect class="box" x="160" y="36" width="70" height="48" rx="3" />
  <text x="195.0" y="65.0" text-anchor="middle"><tspan class="var">k</tspan></text>
  <path class="ln" d="M230.0,60.0 L290.0,60.0" marker-end="url(#proportionalloop-arrow)" />
  <text x="260.0" y="52.0" text-anchor="middle"><tspan class="var">u</tspan></text>
  <rect class="box" x="290" y="32" width="170" height="56" rx="3" />
  <text x="375.0" y="57.0" text-anchor="middle">Plant</text>
  <text class="small" x="375.0" y="73.0" text-anchor="middle"><tspan class="var">ẋ</tspan> = −<tspan class="var">a</tspan><tspan class="var">x</tspan> + <tspan class="var">b</tspan><tspan class="var">u</tspan></text>
  <path class="ln" d="M460.0,60.0 L556.0,60.0" marker-end="url(#proportionalloop-arrow)" />
  <text x="550.0" y="52.0" text-anchor="end"><tspan class="var">x</tspan></text>
  <circle class="dot" cx="510" cy="60" r="3" />
  <path class="ln" d="M510.0,60.0 L510.0,128.0 L90.0,128.0 L90.0,73.0" marker-end="url(#proportionalloop-arrow)" />

</svg>
