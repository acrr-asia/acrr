  <rect class="box" x="440" y="71" width="100" height="48" rx="3" />
  <text x="490.0" y="100.0" text-anchor="middle">Plant</text>
  <path class="ln" d="M540.0,95.0 L634.0,95.0" marker-end="url(#controlloop-arrow)" />
