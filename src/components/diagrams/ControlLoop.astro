      <path class="arrowhead" d="M0,0 L10,5 L0,10 z" />
    </marker>
  </defs>
  <text x="14.0" y="87.0" text-anchor="start"><tspan class="var">r</tspan></text>
  <path class="ln" d="M14.0,95.0 L77.0,95.0" marker-end="url(#controlloop-arrow)" />
  <circle class="box" cx="90" cy="95" r="13" />
