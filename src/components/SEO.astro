---
/**
 * Page metadata: <title>, description, canonical, Open Graph, Twitter and theme-color.
 *
 * Canonical and og:url are emitted ONLY when a real site URL was provided at build time
 * (SITE_URL, read in astro.config.mjs). When `Astro.site` is the localhost fallback they are
 * omitted, so a domain is never invented. There is deliberately no og:image: no image exists.
 */
import { publicPath } from '../lib/path';
import { LANG_TAGS, type Lang } from '../i18n/ui';

interface Props {
  /** Full <title> text. */
  title: string;
  description: string;
  /** Optional explicit canonical (absolute URL, or a path resolved against the configured site). */
  canonical?: string;
  ogType?: 'website' | 'article';
  /** Adds <meta name="robots" content="noindex"> and drops canonical / og:url. */
  noindex?: boolean;
  /** Public path of this page in each language that has it (for hreflang). */
  alternates?: Partial<Record<Lang, string>>;
  lang?: Lang;
}

const { title, description, canonical, ogType = 'website', noindex = false, alternates = {}, lang = 'en' } = Astro.props;

const SITE_NAME = 'ACRR';

const site = Astro.site;
const isPlaceholderHost = (host: string) =>
  host === 'localhost' || host === '127.0.0.1' || host === '[::1]' || host.endsWith('.localhost');
const realSite = site && !isPlaceholderHost(site.hostname) ? site : undefined;

// With `build.format: 'file'`, Astro.url.pathname is "/blog.html" / "/index.html" during the
// build but "/blog" in dev. Normalise to the extensionless, no-trailing-slash public route.
const path = publicPath(Astro.url.pathname);

let canonicalUrl: string | undefined;
if (!noindex) {
  if (canonical) {
    try {
      canonicalUrl = new URL(canonical, realSite?.origin).href;
    } catch {
      canonicalUrl = undefined; // relative canonical but no real site configured: omit
    }
  } else if (realSite) {
    canonicalUrl = new URL(path, realSite.origin).href;
  }
}
// hreflang links need absolute URLs, so like canonical they are emitted only with a real site, and
// only when the page exists in more than one language.
const hreflang =
  realSite && !noindex && Object.values(alternates).filter(Boolean).length > 1
    ? (Object.entries(alternates) as [Lang, string | undefined][])
        .filter((e): e is [Lang, string] => Boolean(e[1]))
        .map(([l, p]) => ({ lang: LANG_TAGS[l], href: new URL(p, realSite.origin).href }))
    : [];
const enHref = hreflang.find((h) => h.lang === LANG_TAGS.en)?.href;
---
<title>{title}</title>
<meta name="description" content={description} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex" />}
{hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
{enHref && <link rel="alternate" hreflang="x-default" href={enHref} />}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_GB'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Meta tags cannot read CSS variables; these mirror --bg in src/styles/tokens.css. -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf7" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131312" />
