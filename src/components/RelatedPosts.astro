---
import type { CollectionEntry } from 'astro:content';
import { entryLang, formatDate, postHref } from '../lib/content';
import { categoryLabel, langFromUrl, t } from '../i18n/ui';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const lang = langFromUrl(Astro.url);
const ui = t(lang);

// The section carries `data-pagefind-ignore`: other articles' titles and summaries are not this
// page's content, so they must not make the page match searches for those articles.
---
{posts.length > 0 && (
  <section class="related" aria-labelledby="related-title" data-pagefind-ignore>
    <p class="eyebrow">{ui.keepReading}</p>
    <h2 id="related-title">{ui.relatedArticles}</h2>
    <ul class="list">
      {posts.map((p) => (
        <li>
          <p class="meta dotted">
            <time datetime={p.data.publishedAt.toISOString().slice(0, 10)}>{formatDate(p.data.publishedAt, lang)}</time>
            <span>{categoryLabel(p.data.category, lang)}</span>
            {entryLang(p) !== lang && <span class="badge" lang="en">{ui.inEnglish}</span>}
            {p.data.example && <span class="badge notice">{ui.example}</span>}
          </p>
          <p class="title"><a href={postHref(p)} lang={entryLang(p) !== lang ? 'en' : undefined}>{p.data.title}</a></p>
          <p class="summary" lang={entryLang(p) !== lang ? 'en' : undefined}>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related { margin-top: var(--space-6); }
  .related h2 { margin-top: var(--space-1); font-size: 1.3rem; }
  .list > li { padding-block: var(--space-3); }
  .meta { margin: 0 0 var(--space-1); }
  .title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .title a { color: var(--ink); text-underline-offset: 0.2em; }
  .title a:hover { color: var(--accent); }
  .summary { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }
</style>
