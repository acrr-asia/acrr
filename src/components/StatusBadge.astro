---
/** Status of a series (or any planned / in-progress / published item). */
type Status = 'planned' | 'in-progress' | 'published';
interface Props { status: Status }

const { status } = Astro.props;
const labels: Record<Status, string> = {
  planned: 'Planned',
  'in-progress': 'In progress',
  published: 'Published',
};
---
<span class:list={['badge', 'status', `status-${status}`]}>{labels[status]}</span>

<style>
  .status { white-space: nowrap; }
  .status-planned { border-style: dashed; }
  .status-in-progress { border-color: var(--accent); color: var(--accent); }
  .status-published { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
</style>
