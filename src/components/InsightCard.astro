---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

/** `level` is the heading level for the title (default 3, for use inside an h2 section). */
interface Props { insight: CollectionEntry<'insights'>; level?: 2 | 3 }

const { insight, level = 3 } = Astro.props;
const { data } = insight;
const href = `/insights/${insight.id}`;
const Heading = `h${level}` as 'h2' | 'h3';
---
<article class="insight-card">
  <p class="meta">
    <time datetime={data.publishedAt.toISOString().slice(0, 10)}>{formatDate(data.publishedAt)}</time>
    <span>{data.kind}</span>
    {data.example && <span class="badge notice">Example</span>}
    {data.draft && <span class="badge">Draft</span>}
  </p>
  <Heading class="title"><a href={href}>{data.title}</a></Heading>
  <p class="summary">{data.description}</p>
  <p class="more">
    <a href={href}>Read insight<span aria-hidden="true"> →</span><span class="sr-only">: {data.title}</span></a>
  </p>
</article>

<style>
  .meta { align-items: center; margin: 0 0 var(--space-2); }
  .title { font-size: 1.3rem; margin: 0 0 var(--space-2); }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--accent); text-decoration: underline; }
  .summary { margin: 0 0 var(--space-2); color: var(--ink-muted); max-width: var(--measure); }
  .more { margin: 0; font-weight: 600; }
</style>
