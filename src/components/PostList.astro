---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { entryLang } from '../lib/content';
import { langFromUrl, t } from '../i18n/ui';

interface Props {
  /** Posts in display order (newest first). */
  posts: CollectionEntry<'blog'>[];
  /** Heading level of the year headings (2 by default; 3 when nested under another h2). */
  level?: 2 | 3;
  /** false renders one flat list without year headings (used on tag pages). */
  groupByYear?: boolean;
}

const { posts, level = 2, groupByYear = true } = Astro.props;
const YearHeading = `h${level}` as 'h2' | 'h3';

// Group by publication year, preserving the given (newest-first) order.
const groups = new Map<number, CollectionEntry<'blog'>[]>();
for (const post of posts) {
  const year = post.data.publishedAt.getUTCFullYear();
  const bucket = groups.get(year);
  if (bucket) bucket.push(post);
  else groups.set(year, [post]);
}
const hasExamples = posts.some((p) => p.data.example);
const lang = langFromUrl(Astro.url);
const ui = t(lang);
const hasForeign = posts.some((p) => entryLang(p) !== lang);
---
{posts.length === 0 ? (
  <p class="empty">{ui.noArticles}</p>
) : (
  <>
    {hasExamples && (
      <p class="sample-note" role="note">
        <span class="badge notice">{ui.example}</span>{' '}
        {ui.exampleListNote}
      </p>
    )}
    {hasForeign && ui.untranslatedNote && (
      <p class="sample-note" role="note">
        <span class="badge" lang="en">{ui.inEnglish}</span>{' '}
        {ui.untranslatedNote}
      </p>
    )}
    {!groupByYear && (
      <ul class="list">
        {posts.map((post) => (
          <li><PostCard post={post} showTags /></li>
        ))}
      </ul>
    )}
    {groupByYear && [...groups].map(([year, items]) => (
      <section aria-labelledby={`year-${year}`}>
        <YearHeading id={`year-${year}`} class="year">{year}</YearHeading>
        <ul class="list">
          {items.map((post) => (
            <li><PostCard post={post} showTags /></li>
          ))}
        </ul>
      </section>
    ))}
  </>
)}

<style>
  .empty { color: var(--ink-muted); }
  .sample-note {
    margin: 0 0 var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg-subtle);
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
  .sample-note .badge { margin-right: var(--space-2); }
  .year {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-muted);
    margin: var(--space-5) 0 var(--space-2);
  }
</style>
