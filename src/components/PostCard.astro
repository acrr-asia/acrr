---
import { render, type CollectionEntry } from 'astro:content';
import { entryLang, formatDate, postHref } from '../lib/content';
import { categoryLabel, langFromUrl, t } from '../i18n/ui';
import TagList from './TagList.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Show the tag list under the summary (used by the archive). */
  showTags?: boolean;
}

const { post, showTags = false } = Astro.props;
const { data } = post;
const href = postHref(post);
const lang = langFromUrl(Astro.url);
const ui = t(lang);
// An untranslated article listed on a page in another language links to the original.
const foreign = entryLang(post) !== lang;

// Reading time is computed from the article text by the remark plugin.
const { remarkPluginFrontmatter } = await render(post);
const minutes = remarkPluginFrontmatter?.minutesRead;
---
<article class="card">
  <p class="meta dotted">
    <time datetime={data.publishedAt.toISOString().slice(0, 10)}>{formatDate(data.publishedAt, lang)}</time>
    <span>{categoryLabel(data.category, lang)}</span>
    {typeof minutes === 'number' && <span>{ui.minRead(minutes)}</span>}
    {foreign && <span class="badge" lang="en" data-pagefind-ignore>{ui.inEnglish}</span>}
    {data.example && <span class="badge notice" data-pagefind-ignore>{ui.example}</span>}
    {data.draft && <span class="badge" data-pagefind-ignore>{ui.draft}</span>}
  </p>
  <h3 class="title"><a href={href} hreflang={foreign ? 'en' : undefined}><span lang={foreign ? 'en' : undefined}>{data.title}</span></a></h3>
  <p class="summary" lang={foreign ? 'en' : undefined}>{data.description}</p>
  {showTags && <TagList tags={data.tags} />}
  <p class="more" aria-hidden="true" data-pagefind-ignore>{ui.readArticle}</p>
</article>

<style>
  .card { position: relative; }
  .meta { margin: 0 0 var(--space-2); }
  .title {
    font-size: 1.35rem;
    margin: 0 0 var(--space-2);
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Stretched link: the whole card is one click target and one tab stop. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible { outline: none; }
  .title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .card:hover:not(:has(.tags a:hover)) .title a { text-decoration: underline; text-underline-offset: 0.2em; }
  .summary {
    margin: 0 0 var(--space-3);
    max-width: var(--measure);
    color: var(--ink-muted);
  }
  .card :global(.tags) { margin-bottom: var(--space-3); }
  /* Tag links sit above the stretched title link so they stay clickable. */
  .card :global(.tags a) { position: relative; z-index: 1; }
  .more {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
