---
/**
 * An unnumbered figure for diagrams in articles. Wrap an inline SVG diagram component
 * (src/components/diagrams/*) and give a caption, which is indexed by search; the SVG itself
 * carries data-pagefind-ignore so its labels do not leak into search excerpts.
 */
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---
<figure class="diagram">
  <div class="diagram-frame"><slot /></div>
  <figcaption>{caption}</figcaption>
</figure>
