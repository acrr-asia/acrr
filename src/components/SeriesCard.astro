---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import { entryLang, seriesHref } from '../lib/content';
import { categoryLabel, langFromUrl, t } from '../i18n/ui';

/**
 * `count` is the number of published (non-draft) articles in the series,
 * i.e. getSeriesPosts(series.id).length. Planned entries come from the series data.
 * `level` is the heading level for the title (default 3, for use inside an h2 section).
 */
interface Props { series: CollectionEntry<'series'>; count: number; level?: 2 | 3 }

const { series, count, level = 3 } = Astro.props;
const { data } = series;
const href = seriesHref(series);
const lang = langFromUrl(Astro.url);
const ui = t(lang);
const foreign = entryLang(series) !== lang;
const total = count + data.plannedEntries.length;
const Heading = `h${level}` as 'h2' | 'h3';
---
<article class="series-card">
  <p class="meta">
    <span>{categoryLabel(data.category, lang)}</span>
    <StatusBadge status={data.status} />
    {foreign && <span class="badge" lang="en">{ui.inEnglish}</span>}
    {data.example && <span class="badge notice">{ui.example}</span>}
  </p>
  <Heading class="title"><a href={href} lang={foreign ? 'en' : undefined}>{data.title}</a></Heading>
  <p class="summary" lang={foreign ? 'en' : undefined}>{data.description}</p>
  <p class="progress">
    {ui.entriesPublished(count, total)}
  </p>
  <p class="more">
    <a href={href}>{ui.viewSeries}<span aria-hidden="true"> →</span><span class="sr-only">: {data.title}</span></a>
  </p>
</article>

<style>
  .meta { align-items: center; margin: 0 0 var(--space-2); }
  .title { font-size: 1.3rem; margin: 0 0 var(--space-2); }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--accent); text-decoration: underline; }
  .summary { margin: 0 0 var(--space-2); color: var(--ink-muted); max-width: var(--measure); }
  .progress {
    margin: 0 0 var(--space-2); font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-muted);
  }
  .more { margin: 0; font-weight: 600; }
</style>
