---
import { getTagIndex } from '../lib/content';

interface Props {
  /** Tag slug currently being viewed; omit on the blog archive. */
  active?: string;
  /** How many tags to list before the "All tags" link. */
  limit?: number;
  /** 'posts' counts articles only (blog archive), 'insights' counts insights only, 'all' counts both. */
  scope?: 'posts' | 'insights' | 'all';
}

const { active, limit = 8, scope = 'all' } = Astro.props;
const countOf = (t: { count: number; posts: unknown[]; insights: unknown[] }) =>
  scope === 'posts' ? t.posts.length : scope === 'insights' ? t.insights.length : t.count;
const tags = (await getTagIndex())
  .filter((t) => countOf(t) > 0)
  .sort((a, b) => countOf(b) - countOf(a) || a.name.localeCompare(b.name));
const shown = tags.slice(0, limit);
// Keep the active tag visible even when it is not among the most used ones.
const current = active ? tags.find((t) => t.slug === active) : undefined;
if (current && !shown.some((t) => t.slug === current.slug)) shown.push(current);
const hidden = tags.length - shown.length;
---
{tags.length > 0 && (
  <nav class="tag-nav" aria-label="Browse by tag" data-pagefind-ignore>
    <span class="label">Tags</span>
    <ul>
      {shown.map((t) => (
        <li>
          <a href={`/tags/${t.slug}`} aria-current={active === t.slug ? 'page' : undefined}>{t.name} <span class="count">{countOf(t)}</span></a>
        </li>
      ))}
      <li class="all"><a href="/tags">{hidden > 0 ? `All tags (+${hidden})` : 'All tags'} <span aria-hidden="true">→</span></a></li>
    </ul>
  </nav>
)}

<style>
  .tag-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }
  .label { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-muted); }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); margin: 0; padding: 0; }
  a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  a:hover { border-color: var(--rule); }
  a[aria-current='page'] { border-color: var(--accent); font-weight: 600; }
  .count { color: var(--ink-muted); }
  .all a { color: var(--accent); }
</style>
