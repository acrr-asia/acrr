---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import TagList from '../components/TagList.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticlePager from '../components/ArticlePager.astro';
import {
  baseId, entryLang, formatDate, getPosts, getRelatedPosts, getSeries, getSeriesPosts, hasTranslation, postHref, seriesHref, slugify,
} from '../lib/content';
import { categoryLabel, localizePath, t } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Reading time from the remark plugin; omitted when it could not be computed. */
  minutesRead?: number;
  /** Headings of the rendered body (from `render()`), used for the Contents aside. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, minutesRead, headings = [] } = Astro.props;
const { data } = post;
const lang = entryLang(post);
const ui = t(lang);
const id = baseId(post);
// The same article in the other language: a translation always has its original; an original
// may not have a translation yet, and a Vietnamese original has no English version yet.
const counterpart =
  lang === 'en'
    ? (await hasTranslation('blog', id)) ? `/blog/${id}` : null
    : data.originalLang === 'vi' ? null : `/blog/${id}`;
const blogHome = localizePath('/blog', lang);

// Series context: previous/next among the articles that are actually listed.
const seriesEntry = data.series ? await getSeries(data.series.id, lang) : undefined;
const seriesPosts = data.series ? await getSeriesPosts(data.series.id, lang) : [];
const position = seriesPosts.findIndex((p) => p.id === post.id);
const prev = position > 0 ? seriesPosts[position - 1] : undefined;
const next = position >= 0 ? seriesPosts[position + 1] : undefined;

// Chronological neighbours for every article (series articles also get the series pager above it).
const allPosts = await getPosts(lang);
const index = allPosts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? allPosts[index - 1] : undefined;
const older = index >= 0 ? allPosts[index + 1] : undefined;

const related = await getRelatedPosts(post, 3, lang);
const isoDate = data.publishedAt.toISOString().slice(0, 10);
const hasReadingTime = typeof minutesRead === 'number' && minutesRead > 0;
const eyebrow = seriesEntry ? ui.partOf(data.seriesOrder, seriesEntry.data.title) : ui.articleEyebrow;
// Neighbours that are not translated are listed in English.
const foreignLang = (p: CollectionEntry<'blog'>) => (entryLang(p) !== lang ? 'en' : undefined);
---
<Base title={data.title} description={data.description} example={data.example ? 'article' : undefined} counterpart={counterpart}>
  <article class="article">
    <p class="back"><a href={blogHome}>{ui.backToBlog}</a></p>

    <header class="head">
      <p class="eyebrow" data-pagefind-ignore>{eyebrow}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <p class="meta dotted" data-pagefind-ignore>
        <time datetime={isoDate}>{formatDate(data.publishedAt, lang)}</time>
        <span>
          <a href={localizePath(`/blog/category/${slugify(data.category)}`, lang)} data-pagefind-filter="category">{categoryLabel(data.category, lang)}</a>
        </span>
        {hasReadingTime && <span>{ui.minRead(minutesRead)}</span>}
        {data.updatedAt && (
          <span>{ui.updated} <time datetime={data.updatedAt.toISOString().slice(0, 10)}>{formatDate(data.updatedAt, lang)}</time></span>
        )}
      </p>
    </header>

    {data.example && (
      <aside class="callout" role="note" aria-label={ui.exampleArticle}>
        <span class="badge notice">{ui.exampleArticle}</span>
        <span>{ui.exampleArticleNotice}</span>
      </aside>
    )}
    {data.draft && (
      <aside class="callout" role="note" aria-label={ui.draft}>
        <span class="badge">{ui.draft}</span>
        <span>{ui.draftNotice}</span>
      </aside>
    )}
    {ui.translationNote && data.originalLang !== 'vi' && (
      <p class="translation-note" data-pagefind-ignore>
        {ui.translationNote}{' '}<a href={`/blog/${id}`} hreflang="en">{ui.translationLink}</a>.
      </p>
    )}

    <TableOfContents headings={headings} />

    <div class="prose">
      <slot />
    </div>

    {data.tags.length > 0 && (
      <footer class="tags-block">
        <p class="label">{ui.tags}</p>
        <TagList tags={data.tags} />
      </footer>
    )}

    {seriesEntry && (
      <nav class="series-nav" aria-labelledby="series-nav-title" data-pagefind-ignore>
        <p class="eyebrow">{ui.seriesEyebrow}</p>
        <h2 id="series-nav-title">
          {ui.partNOf(data.seriesOrder)}
          <a href={seriesHref(seriesEntry)}>{seriesEntry.data.title}</a>
        </h2>
        {(prev || next) && (
          <ul class="pager">
            {prev && (
              <li class="prev">
                <span class="dir">{ui.prevInSeries}</span>
                <a href={postHref(prev)} lang={foreignLang(prev)}>{prev.data.title}</a>
              </li>
            )}
            {next && (
              <li class="next">
                <span class="dir">{ui.nextInSeries}</span>
                <a href={postHref(next)} lang={foreignLang(next)}>{next.data.title}</a>
              </li>
            )}
          </ul>
        )}
        <p class="all"><a href={seriesHref(seriesEntry)}>{ui.fullSeries}</a></p>
      </nav>
    )}

    <ArticlePager older={older} newer={newer} />

    <RelatedPosts posts={related} />

    <p class="back bottom"><a href={blogHome}>{ui.backToAll}</a></p>
  </article>
</Base>

<style>
  /* Narrow screens: a plain block, so the pinned Contents bar (a sticky child) stays pinned for the
     whole article; inside a grid it would only stick within its own row. Wide screens: text column
     plus a sticky Contents aside (placed by TableOfContents). */
  .article { max-width: 42rem; }
  @media (min-width: 64rem) {
    .article {
      display: grid;
      max-width: none;
      grid-template-columns: minmax(0, 40rem) 15rem;
      column-gap: var(--space-5);
      justify-content: space-between;
    }
  }
  .back { margin: 0 0 var(--space-4); font-family: var(--font-mono); font-size: 0.85rem; }
  .back a { display: inline-block; padding-block: 0.3rem; }
  .back.bottom { margin: var(--space-5) 0 0; }
  .head { margin-bottom: var(--space-4); }
  .translation-note { margin: 0 0 var(--space-4); font-size: 0.9rem; color: var(--ink-muted); }
  .head h1 { margin-top: var(--space-2); }
  .head .meta { margin: 0 0 var(--space-1); }
  .callout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg-subtle);
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
  .tags-block {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
  .label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .series-nav {
    margin-top: var(--space-5);
    padding: var(--space-4) 0 var(--space-3);
    border-block: 1px solid var(--rule);
  }
  .series-nav h2 { margin: var(--space-1) 0 var(--space-3); font-size: 1.3rem; }
  .pager {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    padding: 0;
  }
  .pager li { display: flex; flex-direction: column; gap: var(--space-1); }
  .dir { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-muted); }
  .pager a { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 600; }
  .all { margin: 0; font-size: 0.9rem; }
  @media (min-width: 40rem) {
    .pager { grid-template-columns: 1fr 1fr; gap: var(--space-4); }
    .pager .next { grid-column: 2; text-align: right; }
  }
</style>
