---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
// Self-hosted variable fonts with full Vietnamese coverage, used on Vietnamese pages only (see
// tokens.css). Each @font-face carries a unicode-range, so browsers fetch only the Latin and
// Vietnamese subsets, and only on pages whose font stack names these families.
import '@fontsource-variable/noto-serif/wght.css';
import '@fontsource-variable/noto-serif/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import Search from '../components/Search.astro';
import { publicPath } from '../lib/path';
import { LANGS, langFromUrl, localizePath, t, unlocalizePath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  narrow?: boolean;
  /** Explicit canonical URL (absolute, or a path resolved against the configured site). Usually omitted. */
  canonical?: string;
  /** Open Graph type. Defaults to 'article' under /blog/<slug> and /insights/<slug> (not /blog/category/*), else 'website'. */
  ogType?: 'website' | 'article';
  /** Emit noindex and keep the page out of the search index (used by the 404 page). */
  noindex?: boolean;
  /**
   * Whether the page is indexed by Pagefind (default true). Pass `false` on listing pages (home,
   * the blog archive and category pages, the tags index and tag pages, the series and insights indexes): their content is
   * indexed on the pages it belongs to, and indexing the listings too makes search return
   * duplicates and ambiguous titles such as a bare category name.
   */
  searchable?: boolean;
  /**
   * Marks the page as sample content, naming what it is. Surfaces the flag outside the page body:
   * `[Example]` in <title>, an "Example <kind>:" prefix on the meta/og description, and an
   * `example` value in the Pagefind index (the search dialog shows an Example badge from it).
   */
  example?: 'article' | 'insight' | 'series';
  /**
   * The English route of this page's counterpart in the other language. By default every page is
   * assumed to exist in both languages at the mirrored path (/blog <-> /vi/blog). Pages whose
   * translation may be missing (articles, insights, series) pass the English route when the other
   * version exists and `null` when it does not; the language switcher then links to the other
   * language's section index (or home page) and no hreflang link is emitted.
   */
  counterpart?: string | null;
}
const {
  title,
  description,
  narrow = false,
  canonical,
  ogType,
  noindex = false,
  searchable = true,
  example,
  counterpart,
} = Astro.props;
const lang = langFromUrl(Astro.url);
const ui = t(lang);
const here = unlocalizePath(publicPath(Astro.url.pathname));
const englishRoute = counterpart === undefined ? here : counterpart;
// Public path of this page in each language; missing when that version does not exist.
const alternates = Object.fromEntries(
  LANGS.map((l) => [l, l === lang ? localizePath(here, l) : englishRoute === null ? undefined : localizePath(englishRoute, l)]),
) as Record<Lang, string | undefined>;
const baseTitle = title === 'ACRR' ? ui.siteName : `${title} · ACRR`;
const fullTitle = example ? `${ui.exampleTitlePrefix} ${baseTitle}` : baseTitle;
const metaDescription = example ? ui.exampleDescription(example, description) : description;
// Articles and insights are /blog/<slug> and /insights/<slug>. /blog/category/<slug> is a listing.
const ARTICLE_PATH = /^\/(?:blog\/(?!category(?:\/|$))|insights\/)[^/]+/;
const resolvedOgType = ogType ?? (ARTICLE_PATH.test(here) ? 'article' : 'website');
const indexed = searchable && !noindex;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <SEO title={fullTitle} description={metaDescription} canonical={canonical} ogType={resolvedOgType} noindex={noindex} alternates={alternates} lang={lang} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={ui.siteName} href={localizePath('/rss.xml', lang)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <Header alternates={alternates} />
    <main id="main" class:list={['container', { narrow }]} data-pagefind-body={indexed ? '' : undefined}>
      {example && indexed && <span hidden data-pagefind-meta={`example:${ui.example}`}></span>}
      <slot />
    </main>
    <Footer />
    <Search />
  </body>
</html>
