---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import Search from '../components/Search.astro';
import { publicPath } from '../lib/path';

interface Props {
  title: string;
  description: string;
  narrow?: boolean;
  /** Explicit canonical URL (absolute, or a path resolved against the configured site). Usually omitted. */
  canonical?: string;
  /** Open Graph type. Defaults to 'article' under /blog/<slug> and /insights/<slug> (not /blog/category/*), else 'website'. */
  ogType?: 'website' | 'article';
  /** Emit noindex and keep the page out of the search index (used by the 404 page). */
  noindex?: boolean;
  /**
   * Whether the page is indexed by Pagefind (default true). Pass `false` on listing pages (home,
   * the blog archive and category pages, the tags index and tag pages, the series and insights indexes): their content is
   * indexed on the pages it belongs to, and indexing the listings too makes search return
   * duplicates and ambiguous titles such as a bare category name.
   */
  searchable?: boolean;
  /**
   * Marks the page as sample content, naming what it is. Surfaces the flag outside the page body:
   * `[Example]` in <title>, an "Example <kind>:" prefix on the meta/og description, and an
   * `example` value in the Pagefind index (the search dialog shows an Example badge from it).
   */
  example?: 'article' | 'insight' | 'series';
}
const {
  title,
  description,
  narrow = false,
  canonical,
  ogType,
  noindex = false,
  searchable = true,
  example,
} = Astro.props;
const baseTitle = title === 'ACRR' ? 'ACRR — Advanced Computing & Robotics Research' : `${title} · ACRR`;
const fullTitle = example ? `[Example] ${baseTitle}` : baseTitle;
const metaDescription = example ? `Example ${example}: ${description}` : description;
// Articles and insights are /blog/<slug> and /insights/<slug>. /blog/category/<slug> is a listing.
const ARTICLE_PATH = /^\/(?:blog\/(?!category(?:\/|$))|insights\/)[^/]+/;
const resolvedOgType = ogType ?? (ARTICLE_PATH.test(publicPath(Astro.url.pathname)) ? 'article' : 'website');
const indexed = searchable && !noindex;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <SEO title={fullTitle} description={metaDescription} canonical={canonical} ogType={resolvedOgType} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="ACRR — Advanced Computing & Robotics Research" href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['container', { narrow }]} data-pagefind-body={indexed ? '' : undefined}>
      {example && indexed && <span hidden data-pagefind-meta="example:Example"></span>}
      <slot />
    </main>
    <Footer />
    <Search />
  </body>
</html>
