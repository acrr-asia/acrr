---
import Base from '../layouts/Base.astro';
import { researchAreas } from '../components/home/research-areas';

const principles = [
  {
    title: 'Technical accuracy',
    text: 'Statements are checked before they are published, and errors are corrected when they are found.',
  },
  {
    title: 'Reproducibility where applicable',
    text: 'When an article describes a computation or an experiment, it should give enough detail for a reader to repeat it.',
  },
  {
    title: 'Clear assumptions and limitations',
    text: 'Every method works under some conditions and fails outside them. Articles state which.',
  },
  {
    title: 'Evidence-based conclusions',
    text: 'Conclusions follow from derivations, measurements or cited sources, not from assertion.',
  },
  {
    title: 'Continuous learning and iteration',
    text: 'Understanding improves, so articles may be revised. Revisions should be visible, not silent.',
  },
  {
    title: 'Established results and exploratory ideas kept apart',
    text: 'Established results, interpretations and open questions are labelled as different things.',
  },
];
---
<Base
  title="About"
  description="The mission, research scope, working principles and long-term direction of ACRR, an independent research and technical publishing platform."
  narrow
>
  <header class="page-head">
    <p class="eyebrow">about</p>
    <h1>About ACRR</h1>
    <p class="lede">
      ACRR, Advanced Computing &amp; Robotics Research, is an independent research and technical
      publishing platform. This page explains what it is for and how it intends to work.
    </p>
  </header>

  <div class="prose">
    <section aria-labelledby="mission">
      <h2 id="mission">Mission</h2>
      <p>
        To explore advanced computing and robotics through rigorous technical study,
        experimentation, and research-oriented publishing.
      </p>
    </section>

    <section aria-labelledby="scope">
      <h2 id="scope">Research scope</h2>
      <p>
        ACRR proposes to investigate the following fields. They are areas of interest. Listing a
        field here does not mean there is an active project, a funded programme or a staffed
        laboratory in it.
      </p>
      <ul>
        {researchAreas.map((area) => (
          <li><strong>{area.title}.</strong> {area.description}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="principles">
      <h2 id="principles">Working principles</h2>
      <p>These are the standards the writing on this site is meant to be held to.</p>
      <ul>
        {principles.map((p) => (
          <li><strong>{p.title}.</strong> {p.text}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="direction">
      <h2 id="direction">Long-term direction</h2>
      <p>
        ACRR starts as an independent publishing platform: articles, series, insights and an index
        of learning resources. The intention is to develop it, step by step, into a more
        comprehensive research environment that may eventually support projects, collaboration and
        laboratory activities. That is a direction, not a description of the present, and no timeline
        is implied.
      </p>
    </section>

    <section aria-labelledby="about-site">
      <h2 id="about-site">About the content and the author</h2>
      <p>
        Articles, series and insights are published once they are complete. Series and entries that
        have not been written yet are labelled as planned. Any sample material that only illustrates
        a format is marked <span class="badge notice">Example</span> and should not be read as
        completed original research.
      </p>
      <p>
        This page deliberately contains no personal biography, credentials, affiliations or contact
        details. Personal information is added only when it is supplied by the site's author.
      </p>
    </section>

    <nav class="next" aria-label="Continue exploring">
      <p class="eyebrow">continue</p>
      <ul>
        <li><a href="/blog">Read the blog</a></li>
        <li><a href="/series">Browse series</a></li>
        <li><a href="/insights">See insights</a></li>
        <li><a href="/learning">Browse learning resources</a></li>
      </ul>
    </nav>
  </div>
</Base>

<style>
  .page-head { margin-bottom: var(--space-4); }
  .page-head .eyebrow { margin: 0 0 var(--space-2); }
  .page-head .lede { margin: 0; }

  .prose section:first-child h2 { margin-top: var(--space-4); }
  .prose li { margin-block: 0.5em; }

  .next {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 1rem;
  }
  .next .eyebrow { margin: 0 0 var(--space-2); }
  .next ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .next li { margin: 0; }
  .next a { display: inline-block; padding-block: 0.25rem; }
</style>
