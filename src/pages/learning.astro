---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { slugify } from '../lib/content';

type Entry = CollectionEntry<'learning'>;

const entries = await getCollection('learning');
// Authoring note (source only, not shown to visitors): real links are added by setting `url` on an
// entry in src/data/learning.json. The notice below must stay true as that happens (see README).
const hasLinks = entries.some((entry) => entry.data.url);

const statusLabel: Record<Entry['data']['status'], string> = {
  planned: 'Planned',
  'in-progress': 'In progress',
  published: 'Published',
};

// Group by topic: topics alphabetically, entries by title.
const byTopic = new Map<string, Entry[]>();
for (const entry of entries) {
  const list = byTopic.get(entry.data.topic) ?? [];
  list.push(entry);
  byTopic.set(entry.data.topic, list);
}
const groups = [...byTopic.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([topic, items]) => ({
    topic,
    id: `topic-${slugify(topic)}`,
    items: items.sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }));
---
<Base
  title="Learning"
  description="An index of planned learning paths, study notes and references. Entries without a public page are marked Coming soon."
>
  <header class="page-head">
    <p class="eyebrow">learning</p>
    <h1>Learning resources</h1>
    <p class="lede">
      An index of learning paths, study notes and external references. It points to material; it does
      not duplicate it.
    </p>
  </header>

  <div class="notice-box">
    {hasLinks ? (
      <p>
        Learning resources are being organised. Entries with a link open a public page; entries
        without one are marked <strong>Coming soon</strong>. More links will appear here as
        resources are published. The written material on the site lives in
        the <a href="/blog">blog</a> and the <a href="/series">series</a>.
      </p>
    ) : (
      <p>
        Learning resources are being organised. No entry below links to an external page yet, so
        each planned collection is marked <strong>Coming soon</strong>. Links will appear here as
        resources are published. Until then, the written material on the site lives
        in the <a href="/blog">blog</a> and the <a href="/series">series</a>.
      </p>
    )}
  </div>

  {groups.length === 0 ? (
    <p class="empty">No learning resources are listed yet.</p>
  ) : (
    groups.map((group) => (
      <section class="topic" aria-labelledby={group.id}>
        <h2 id={group.id}>{group.topic}</h2>
        <ul class="list">
          {group.items.map((entry) => (
            <li class="resource">
              <div class="body">
                <h3>{entry.data.title}</h3>
                <p class="meta">
                  <span>{entry.data.type}</span>
                  <span class:list={['badge', { notice: entry.data.status !== 'planned' }]}>
                    {statusLabel[entry.data.status]}
                  </span>
                </p>
                <p class="desc">{entry.data.description}</p>
              </div>
              <div class="action">
                {entry.data.url ? (
                  <a href={entry.data.url} target="_blank" rel="noopener">
                    Open resource
                    <span class="sr-only"> (external link, opens in a new tab)</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                ) : (
                  <span class="soon">Coming soon</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</Base>

<style>
  .page-head { margin-bottom: var(--space-4); }
  .page-head .eyebrow { margin: 0 0 var(--space-2); }
  .page-head .lede { margin: 0; }

  .notice-box {
    max-width: var(--measure);
    margin-bottom: var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
  }
  .notice-box p { margin: 0; }

  .empty {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--rule);
    border-radius: 4px;
    color: var(--ink-muted);
  }

  .topic { margin-bottom: var(--space-5); }
  .topic h2 { margin: 0 0 var(--space-3); font-size: 1.35rem; }

  .resource { display: grid; gap: var(--space-2) var(--space-4); }
  .resource .body { min-width: 0; }
  .resource h3 { font-size: 1.15rem; margin: 0 0 var(--space-1); }
  .resource .meta { align-items: center; margin: 0 0 var(--space-2); }
  .desc { margin: 0; color: var(--ink-muted); max-width: var(--measure); }
  .action { font-weight: 600; }
  .soon { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 400; color: var(--ink-muted); }

  @media (min-width: 40rem) {
    .resource { grid-template-columns: 1fr auto; align-items: start; }
    .action { padding-top: 0.15rem; }
  }
</style>
