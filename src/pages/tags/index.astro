---
import Base from '../../layouts/Base.astro';
import { getTagIndex } from '../../lib/content';

const tags = await getTagIndex();
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---
<Base
  title="Tags"
  description="Every topic tag used on ACRR, with the number of articles and insights that carry it."
  searchable={false}
>
  <header>
    <p class="eyebrow">tags</p>
    <h1>Tags</h1>
    <p class="lede">
      Topics that run across articles and insights. The number beside each tag is how many entries
      carry it.
    </p>
  </header>

  {tags.length > 0 ? (
    <ul class="tag-list">
      {tags.map((t) => (
        <li>
          <a href={`/tags/${t.slug}`}>
            <span class="name">{t.name}</span>
            <span class="count">{t.count}</span>
            <span class="sr-only">
              ({plural(t.posts.length, 'article', 'articles')}, {plural(t.insights.length, 'insight', 'insights')})
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">No tags yet. Tags appear here once an article or insight uses them.</p>
  )}
</Base>

<style>
  header { margin-bottom: var(--space-4); }
  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
  }
  .tag-list a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .tag-list a:hover { border-color: var(--accent); color: var(--accent); }
  .count { color: var(--ink-muted); font-size: 0.8rem; }
  .empty { color: var(--ink-muted); }
</style>
