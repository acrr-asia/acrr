---
import Base from '../../layouts/Base.astro';
import TagNav from '../../components/TagNav.astro';
import PostList from '../../components/PostList.astro';
import InsightCard from '../../components/InsightCard.astro';
import { getTagIndex, type TagEntry } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getTagIndex();
  return tags.map((entry) => ({ params: { tag: entry.slug }, props: { entry } }));
}

interface Props { entry: TagEntry }

const { entry } = Astro.props;
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const summary = [
  entry.posts.length > 0 ? plural(entry.posts.length, 'article', 'articles') : null,
  entry.insights.length > 0 ? plural(entry.insights.length, 'insight', 'insights') : null,
]
  .filter(Boolean)
  .join(' and ');
---
<Base
  title={`${entry.name} · Tags`}
  description={`${summary} tagged "${entry.name}", newest first.`}
  searchable={false}
>
  <header>
    <p class="eyebrow">tag</p>
    <h1>{entry.name}</h1>
    <p class="lede">{summary} tagged with this topic, newest first. <a href="/tags">All tags</a>.</p>
  </header>

  <TagNav active={entry.slug} />

  {entry.posts.length > 0 && (
    <section aria-labelledby="tag-articles">
      <h2 id="tag-articles" class="group">Articles</h2>
      <PostList posts={entry.posts} groupByYear={false} />
    </section>
  )}

  {entry.insights.length > 0 && (
    <section aria-labelledby="tag-insights">
      <h2 id="tag-insights" class="group">Insights</h2>
      <ul class="list">
        {entry.insights.map((insight) => (
          <li><InsightCard insight={insight} level={3} /></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  header { margin-bottom: var(--space-4); }
  .group { font-size: 1.3rem; margin: var(--space-5) 0 var(--space-2); }
</style>
