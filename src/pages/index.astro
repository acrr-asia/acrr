---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import SectionHead from '../components/home/SectionHead.astro';
import ResearchAreas from '../components/home/ResearchAreas.astro';
import ExploreMenu from '../components/home/ExploreMenu.astro';
import { getPosts, getSeriesList, getSeriesPosts } from '../lib/content';

// Featured publications: the latest three posts. Drafts are excluded in production by getPosts().
const featured = (await getPosts()).slice(0, 3);
const featuredAreExamples = featured.length > 0 && featured.every((p) => p.data.example);

// Research series, each with the number of its published articles.
const seriesList = await getSeriesList();
const seriesWithCounts = await Promise.all(
  seriesList.map(async (series) => ({ series, count: (await getSeriesPosts(series.id)).length })),
);

// Learning resources: summary computed from the real data file.
const learning = await getCollection('learning');
const learningTopics = [...new Set(learning.map((e) => e.data.topic))].sort((a, b) => a.localeCompare(b));
const learningWithLink = learning.filter((e) => e.data.url).length;

const stages = [
  {
    title: 'Publish',
    badge: 'Current focus',
    text: 'Technical articles, research notes and insights, written so that the reasoning and the assumptions are visible, not only the conclusions.',
  },
  {
    title: 'Organise',
    badge: 'Intended',
    text: 'Series and learning paths that connect individual articles into a coherent route through a subject.',
  },
  {
    title: 'Collaborate',
    badge: 'Intended',
    text: 'Projects, collaboration and laboratory activities, if and when there is real work and real people behind them.',
  },
];
---
<Base
  title="ACRR"
  description="ACRR is an independent research and technical publishing platform focused on advanced computing, robotics and related engineering disciplines. It is at an early stage; current articles are labelled samples."
  searchable={false}
>
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">independent research publishing</p>
    <h1 id="hero-title">Advanced Computing &amp; Robotics Research</h1>
    <p class="lede">
      ACRR is an independent research and technical publishing platform. It is intended to bring
      together technical articles, research notes and structured learning series on advanced
      computing, robotics and related engineering disciplines.
    </p>
    <p class="actions">
      <a class="btn primary" href="/blog">Explore Research</a>
      <a class="btn" href="/learning">Browse Learning Resources</a>
    </p>
    <p class="note">
      ACRR is at an early stage. Pages and entries that contain sample material are labelled{' '}
      <span class="badge notice">Example</span>.
    </p>
  </section>

  <section class="block" aria-labelledby="areas-title">
    <SectionHead id="areas-title" eyebrow="research areas" title="Proposed areas of interest" />
    <p class="intro">
      These are the fields ACRR proposes to study. They describe where attention is intended to go,
      not active projects or a staffed laboratory in each area.
    </p>
    <ResearchAreas />
  </section>

  <section class="block" aria-labelledby="featured-title">
    <SectionHead
      id="featured-title"
      eyebrow="featured publications"
      title="Latest articles"
      href="/blog"
      linkLabel="All articles"
    />
    {featured.length > 0 ? (
      <>
        {featuredAreExamples && (
          <p class="intro">
            The articles shown here are sample content, marked <span class="badge notice">Example</span>.
            They illustrate the format and are not completed original research.
          </p>
        )}
        <ul class="list">
          {featured.map((post) => (
            <li><PostCard post={post} /></li>
          ))}
        </ul>
      </>
    ) : (
      <p class="empty">
        No articles have been published yet. New articles will appear here as they are published.
      </p>
    )}
  </section>

  <section class="block" aria-labelledby="series-title">
    <SectionHead
      id="series-title"
      eyebrow="research series"
      title="Structured sequences"
      href="/series"
      linkLabel="All series"
    />
    <p class="intro">
      A series arranges related articles in a reading order. Series marked as planned or in progress
      are illustrative until their articles have been written.
    </p>
    {seriesWithCounts.length > 0 ? (
      <ul class="grid">
        {seriesWithCounts.map(({ series, count }) => (
          <li><SeriesCard series={series} count={count} /></li>
        ))}
      </ul>
    ) : (
      <p class="empty">No series are listed yet.</p>
    )}
  </section>

  <section class="block" aria-labelledby="learning-title">
    <SectionHead
      id="learning-title"
      eyebrow="learning resources"
      title="Learning paths and references"
      href="/learning"
      linkLabel="Browse Learning Resources"
    />
    <p class="intro">
      ACRR intends to curate learning paths, study notes and external references. These are still
      being organised: until a real page exists for an entry, it is marked{' '}
      <strong>Coming soon</strong> and carries no link.
    </p>
    {learning.length > 0 ? (
      <>
        <p class="topics">
          <span class="label">Topics listed so far:</span> {learningTopics.join(' · ')}
        </p>
        <p class="meta">
          <span>{learning.length} {learning.length === 1 ? 'entry' : 'entries'} listed</span>
          <span>{learningWithLink} with a public link</span>
        </p>
      </>
    ) : (
      <p class="empty">No learning resources are listed yet.</p>
    )}
  </section>

  <section class="block" aria-labelledby="direction-title">
    <SectionHead
      id="direction-title"
      eyebrow="platform direction"
      title="From publishing platform to research environment"
      href="/about"
      linkLabel="About ACRR"
    />
    <p class="intro">
      ACRR is intended to grow from an independent publishing platform into a broader research
      ecosystem. Today it is only the first stage: a place to publish and organise technical writing.
      This describes a direction, not a current capability, and no timeline is implied.
    </p>
    <ol class="grid stages">
      {stages.map((stage, i) => (
        <li>
          <p class="meta">
            <span>Stage {i + 1}</span>
            <span class:list={['badge', { notice: i === 0 }]}>{stage.badge}</span>
          </p>
          <h3>{stage.title}</h3>
          <p>{stage.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="block" aria-labelledby="explore-title">
    <SectionHead id="explore-title" eyebrow="navigate" title="Explore ACRR" />
    <ExploreMenu />
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-5) var(--space-6); }
  .hero .eyebrow { margin: 0 0 var(--space-3); }
  .hero h1 {
    font-size: clamp(2.1rem, 6vw, 3.4rem);
    line-height: 1.1;
    max-width: 18em;
    margin-bottom: var(--space-4);
  }
  .hero .lede { font-size: 1.2rem; margin: 0 0 var(--space-4); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: 0 0 var(--space-4); }
  .actions .btn { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .actions .btn:not(.primary):hover { background: var(--bg-subtle); }
  .actions .btn.primary:hover { text-decoration: underline; }
  .note { margin: 0; font-size: 0.9rem; color: var(--ink-muted); max-width: var(--measure); }

  .block { border-top: 1px solid var(--rule); padding-block: var(--space-5); }
  .intro { max-width: var(--measure); margin: 0 0 var(--space-4); color: var(--ink-muted); }
  .empty {
    max-width: var(--measure);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--rule);
    border-radius: 4px;
    color: var(--ink-muted);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4) var(--space-5);
  }
  .grid > li { border-top: 1px solid var(--rule); padding-top: var(--space-3); min-width: 0; }
  .stages h3 { font-size: 1.15rem; margin: var(--space-2) 0 var(--space-2); }
  .stages p:not(.meta) { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }

  .topics { margin: 0 0 var(--space-3); max-width: var(--measure); }
  .topics .label { color: var(--ink-muted); }
</style>
