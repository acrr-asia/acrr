---
import Base from '../../layouts/Base.astro';
import InsightCard from '../../components/InsightCard.astro';
import TagNav from '../../components/TagNav.astro';
import { getInsights } from '../../lib/content';

const insights = await getInsights();
const hasExamples = insights.some((i) => i.data.example);
---
<Base
  title="Insights"
  description="Short technical perspectives on advanced computing and robotics that separate what is established from interpretation and from open questions."
  searchable={false}
>
  <p class="eyebrow">advanced computing &amp; robotics</p>
  <h1>Insights</h1>
  <p class="lede">
    Short perspectives on advanced computing and robotics: concept explanations, comparisons of
    technical approaches, methodological notes, and open questions. Each one keeps three things
    apart: what is established, how it is interpreted, and what remains open.
  </p>

  {hasExamples && (
    <aside class="example-notice" aria-label="About the example insights">
      <p>
        <strong>Example insights.</strong> Entries marked “Example” are sample content that
        demonstrates the format. They are not research results.
      </p>
    </aside>
  )}

  <TagNav scope="insights" />

  {insights.length > 0 ? (
    <ul class="list">
      {insights.map((insight) => (
        <li><InsightCard insight={insight} level={2} /></li>
      ))}
    </ul>
  ) : (
    <p>No insights have been published yet.</p>
  )}
</Base>

<style>
  .example-notice {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    max-width: var(--measure);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
  }
  .example-notice p { margin: 0; }
  .list { margin-top: var(--space-4); }
</style>
