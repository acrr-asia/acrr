---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { formatDate, getInsights } from '../../lib/content';

export async function getStaticPaths() {
  const insights = await getInsights();
  return insights.map((insight) => ({ params: { id: insight.id }, props: { insight } }));
}

interface Props { insight: CollectionEntry<'insights'> }

const { insight } = Astro.props;
const { data } = insight;
const { Content, remarkPluginFrontmatter } = await render(insight);
const minutesRead = remarkPluginFrontmatter?.minutesRead as number | undefined;
---
<Base title={data.title} description={data.description} narrow example={data.example ? 'insight' : undefined}>
  <article>
    <header>
      <p class="eyebrow">Insight</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <p class="meta">
        <time datetime={data.publishedAt.toISOString().slice(0, 10)}>{formatDate(data.publishedAt)}</time>
        <span class="badge kind">{data.kind}</span>
        {data.example && <span class="badge notice">Example</span>}
        {data.draft && <span class="badge">Draft</span>}
        {minutesRead && <span>{minutesRead} min read</span>}
      </p>
    </header>

    {data.example && (
      <aside class="example-notice" aria-label="Example insight notice">
        <p>
          <strong>Example insight.</strong> This piece is sample content that demonstrates the
          Established, Interpretation, and Open questions format. It is not a research result.
        </p>
      </aside>
    )}

    <div class="prose body">
      <Content />
    </div>

    <div class="tags" data-pagefind-ignore><TagList tags={data.tags} /></div>

    <p class="back"><a href="/insights">← All insights</a></p>
  </article>
</Base>

<style>
  header .meta { align-items: center; margin-top: var(--space-3); }

  .example-notice {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
  }
  .example-notice p { margin: 0; }

  .body { margin-top: var(--space-4); }
  /* The three section headings (Established / Interpretation / Open questions) are the page structure. */
  .body :global(h2) {
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: 1.35rem;
  }
  .body :global(h2:first-child) { margin-top: 0; }

  .tags { margin-top: var(--space-5); }

  .back { margin-top: var(--space-4); }
</style>
