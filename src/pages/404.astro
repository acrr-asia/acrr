---
import Base from '../layouts/Base.astro';

const sections = [
  { href: '/', label: 'Home', text: 'What ACRR is and the areas it proposes to explore.' },
  { href: '/blog', label: 'Blog', text: 'Technical articles, research notes and tutorials.' },
  { href: '/series', label: 'Series', text: 'Ordered collections of articles on a single subject.' },
  { href: '/learning', label: 'Learning', text: 'An index of learning paths and resources.' },
  { href: '/insights', label: 'Insights', text: 'Short pieces on concepts, observations and open questions.' },
  { href: '/about', label: 'About', text: 'Mission, research scope and working principles.' },
];
---
<Base title="Page not found" description="The page you requested could not be found on ACRR." noindex>
  <p class="eyebrow">404</p>
  <h1>Page not found</h1>
  <p class="lede">
    The address you followed does not match any page on this site. The page may have been moved or
    renamed, or the link may contain a typo.
  </p>

  <h2>Where to go next</h2>
  <ul class="list sections">
    {sections.map((s) => (
      <li>
        <a class="label" href={s.href}>{s.label}</a>
        <span class="text">{s.text}</span>
      </li>
    ))}
  </ul>

  <p class="search-hint">
    Or <button type="button" class="linklike" data-search-open>search the site</button>.
  </p>
</Base>

<style>
  .sections > li { display: grid; gap: var(--space-1) var(--space-4); }
  .label { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; }
  .text { color: var(--ink-muted); }
  .search-hint { margin-top: var(--space-4); color: var(--ink-muted); }
  .linklike {
    font: inherit; color: var(--accent); background: none; border: 0; padding: 0;
    text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer;
  }
  @media (min-width: 40rem) {
    .sections > li { grid-template-columns: 9rem 1fr; align-items: baseline; }
  }
</style>
