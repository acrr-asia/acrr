---
import Base from '../../../layouts/Base.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, slugify } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

const { category, posts } = Astro.props;
const count = posts.length;
---
<Base
  title={`${category} · Blog`}
  description={`Articles in the ${category} category: ${count} ${count === 1 ? 'article' : 'articles'}, newest first.`}
  searchable={false}
>
  <header>
    <p class="eyebrow">category</p>
    <h1>{category}</h1>
    <p class="lede">
      {count} {count === 1 ? 'article' : 'articles'} in this category, newest first.{' '}
      <a href="/blog">Back to all articles</a>.
    </p>
  </header>
  <CategoryNav active={category} />
  <PostList posts={posts} />
</Base>
