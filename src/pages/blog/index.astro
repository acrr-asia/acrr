---
import Base from '../../layouts/Base.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import PostList from '../../components/PostList.astro';
import TagNav from '../../components/TagNav.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---
<Base
  title="Blog"
  description="A chronological archive of technical articles, research notes, tutorials and engineering write-ups from ACRR."
  searchable={false}
>
  <header>
    <p class="eyebrow">blog</p>
    <h1>Blog</h1>
    <p class="lede">
      Technical articles, research notes, tutorials and engineering write-ups, newest first.
    </p>
  </header>
  <CategoryNav />
  <TagNav scope="posts" />
  <PostList posts={posts} />
</Base>
