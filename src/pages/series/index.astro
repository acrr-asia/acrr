---
import Base from '../../layouts/Base.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { getSeriesList, getSeriesPosts } from '../../lib/content';

const statusRank = { published: 0, 'in-progress': 1, planned: 2 } as const;

const seriesList = (await getSeriesList()).sort(
  (a, b) => statusRank[a.data.status] - statusRank[b.data.status] || a.data.title.localeCompare(b.data.title),
);

// Published = non-draft articles only (drafts appear in `astro dev`, but are never counted).
const items = await Promise.all(
  seriesList.map(async (series) => {
    const posts = await getSeriesPosts(series.id);
    return { series, count: posts.filter((p) => !p.data.draft).length };
  }),
);

const hasExamples = seriesList.some((s) => s.data.example);
---
<Base
  title="Series"
  description="Structured collections of articles that follow a subject in sequence, with published entries listed first and planned entries marked as such."
  searchable={false}
>
  <p class="eyebrow">Structured reading</p>
  <h1>Series</h1>
  <p class="lede">
    A series groups related articles into a sequence so that a subject can be followed in order. Each
    series lists its published articles first, then entries that are planned but not yet written.
  </p>

  {hasExamples && (
    <aside class="example-notice" aria-label="About the example series">
      <p>
        <strong>Example / illustrative series.</strong> The series below show how ACRR intends to
        organize multi-part material. Entries marked “Planned” do not exist yet, and articles marked
        “Example” are sample content, not completed research.
      </p>
    </aside>
  )}

  {items.length > 0 ? (
    <ul class="list">
      {items.map(({ series, count }) => (
        <li><SeriesCard series={series} count={count} level={2} /></li>
      ))}
    </ul>
  ) : (
    <p>No series have been added yet.</p>
  )}
</Base>

<style>
  .example-notice {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    max-width: var(--measure);
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
  }
  .example-notice p { margin: 0; }
  .list { margin-top: var(--space-4); }
</style>
