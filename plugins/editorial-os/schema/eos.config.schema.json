{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acrr-asia/acrr/plugins/editorial-os/schema/eos.config.schema.json",
  "title": "editorial-os publication configuration",
  "type": "object",
  "required": ["version", "publication", "content"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "publication": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "description": "Short machine name; also the Vale style name." },
        "name": { "type": "string" },
        "fullName": { "type": "string" },
        "url": { "type": "string" },
        "standards": { "type": "string", "description": "Path of the standards manual, relative to the project root." },
        "identity": { "type": "string" },
        "audience": { "type": "string" }
      }
    },
    "language": {
      "type": "object",
      "properties": {
        "variant": { "enum": ["en-US", "en-GB"] },
        "serialComma": { "type": "boolean" },
        "contractions": { "enum": ["avoid", "allow"] },
        "headingCase": { "enum": ["sentence", "title", "any"] },
        "titleCase": { "enum": ["headline", "sentence", "any"] }
      }
    },
    "properNouns": { "type": "array", "items": { "type": "string" }, "description": "Capitalized words that do not make a heading title case." },
    "content": {
      "type": "object",
      "required": ["types"],
      "properties": {
        "root": { "type": "string" },
        "types": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["globs"],
            "properties": {
              "label": { "type": "string" },
              "globs": { "type": "array", "items": { "type": "string" } },
              "route": { "type": "string", "description": "Public route pattern with {slug}." },
              "rubric": { "type": "string" },
              "requiredFields": { "type": "array", "items": { "type": "string" } },
              "requiredSections": { "type": "array", "items": { "type": "string" } },
              "isSeriesIndex": { "type": "boolean" }
            }
          }
        },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "fields": { "type": "object", "additionalProperties": { "type": "string" } },
        "proseFields": { "type": "array", "items": { "type": "string" } },
        "seriesArticle": {
          "type": "object",
          "properties": {
            "requiredSections": { "type": "array", "items": { "type": "string" } },
            "entryNoun": { "type": "string" }
          }
        },
        "translations": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Language -> path pattern of a translation, with {dir} and {file}." },
        "pages": {
          "type": "object",
          "properties": {
            "dist": { "type": "string" },
            "routes": { "type": "array", "items": { "type": "string" } },
            "prefixes": { "type": "array", "items": { "type": "string" } },
            "sources": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "titleMaxChars": { "type": "integer" },
        "descriptionMinChars": { "type": "integer" },
        "descriptionMaxChars": { "type": "integer" },
        "sentenceMaxWords": { "type": "integer" },
        "paragraphMaxWords": { "type": "integer" },
        "headingMaxWords": { "type": "integer" }
      }
    },
    "glossary": { "type": "string" },
    "rules": {
      "type": "object",
      "additionalProperties": { "enum": ["error", "warning", "suggestion", "off"] }
    },
    "acronyms": { "type": "object", "properties": { "known": { "type": "array", "items": { "type": "string" } } } },
    "references": {
      "type": "object",
      "properties": {
        "sectionHeadings": { "type": "array", "items": { "type": "string" } },
        "policy": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "recordsDir": { "type": "string" },
        "auditDir": { "type": "string" },
        "stages": { "type": "array", "items": { "type": "string" } },
        "requiredStages": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "minimumTotal": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 28 } },
        "minimumPerDimension": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "run"],
            "properties": { "name": { "type": "string" }, "run": { "type": "string" }, "env": { "type": "object" } }
          }
        },
        "site": {
          "type": "object",
          "properties": {
            "dist": { "type": "string" },
            "ignore": { "type": "array", "items": { "type": "string" } },
            "maxDiagramMinWidthPx": { "type": "number" },
            "descriptionMaxChars": { "type": "integer" },
            "ignoreDuplicateIds": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
