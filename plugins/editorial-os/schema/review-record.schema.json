{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acrr-asia/acrr/plugins/editorial-os/schema/review-record.schema.json",
  "title": "editorial-os review record (written by `eos record`)",
  "type": "object",
  "required": ["schema", "id", "path", "type", "hash", "reviewedAt", "stages", "scores", "total", "decision"],
  "properties": {
    "schema": { "const": "eos-review-record/1" },
    "id": { "type": "string", "description": "<type>/<slug>" },
    "path": { "type": "string" },
    "type": { "type": "string" },
    "title": { "type": "string" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Hash of the file as reviewed; the gate compares it with the current file." },
    "reviewedAt": { "type": "string", "format": "date" },
    "commit": { "type": ["string", "null"] },
    "stages": { "type": "object", "additionalProperties": { "enum": ["pass", "fail", "n/a"] } },
    "scores": {
      "type": "object",
      "required": ["purpose", "structure", "accuracy", "evidence", "language", "consistency", "publishing"],
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4 }
    },
    "total": { "type": "integer", "minimum": 0, "maximum": 28 },
    "critical": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "object",
      "properties": {
        "blocking": { "type": "integer" },
        "shouldFix": { "type": "integer" },
        "optional": { "type": "integer" },
        "open": { "type": "integer", "description": "Blocking or should-fix findings not yet resolved." }
      }
    },
    "lint": { "type": "object", "properties": { "error": { "type": "integer" }, "warning": { "type": "integer" }, "suggestion": { "type": "integer" } } },
    "notVerified": { "type": "array", "items": { "type": "string" } },
    "changes": { "type": "array", "items": { "type": "string" } },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "reportRef": { "type": ["string", "null"] },
    "notes": { "type": "string" },
    "decision": { "enum": ["publish", "revise"] },
    "problems": { "type": "array", "items": { "type": "string" } },
    "history": { "type": "array", "items": { "type": "object" } }
  }
}
