{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acrr-asia/acrr/plugins/editorial-os/schema/queue-entry.schema.json",
  "title": "editorial-os queue entry (one per item, <queue.dir>/<type>/<slug>.json)",
  "description": "Where an item stands in the publication workflow. Unlike a review record it is not tied to the content hash, so editing it never makes a review stale. Created by `eos queue init`, changed by `eos queue set` and by the live-review stage, checked by `eos queue validate`.",
  "type": "object",
  "required": ["schema", "id", "type", "status", "contract", "reviews", "findings", "history"],
  "properties": {
    "schema": { "const": "eos-queue-entry/1" },
    "id": { "type": "string", "description": "<type>/<slug>; equals the file's path under the queue folder." },
    "type": { "type": "string" },
    "source": { "type": ["string", "null"], "description": "Content file, relative to the project root; null for a proposal with no file yet." },
    "url": { "type": ["string", "null"], "description": "Public URL once published." },
    "title": { "type": "string" },
    "format": {
      "enum": [null, "tutorial", "explainer", "comparison", "research-review", "reporting", "analysis", "reference", "sponsored"],
      "description": "What kind of page this is for the reader (strategy 1: pillars must be distinguishable)."
    },
    "valueCategory": {
      "enum": [null, "conceptual-understanding", "practical-implementation", "technical-decision", "research-synthesis", "original-reporting", "reference-value", "critical-analysis"],
      "description": "Primary reader-value category (strategy 2)."
    },
    "risk": {
      "enum": [null, "routine", "high"],
      "description": "high: reporting, claims about named people or organizations, safety-relevant guidance, or anything commercial. A high-risk item is accepted only by a queue.highRiskApprovers person."
    },
    "contract": {
      "type": "object",
      "description": "Reader-value contract (strategy 2). reconstructed = inferred from a published text by a reviewer, never presented as the author's original intent.",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["missing", "reconstructed", "proposed", "approved"] },
        "reader": { "type": ["string", "null"] },
        "problem": { "type": ["string", "null"] },
        "outcome": { "type": ["string", "null"] },
        "contribution": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] },
        "limitations": { "type": ["string", "null"] },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date" }
      }
    },
    "status": {
      "enum": [
        "proposed", "approved-for-research", "drafting", "technical-review", "editorial-review", "revision-required",
        "ready-to-publish", "published-awaiting-live-review", "revision-required-after-publication", "accepted",
        "maintenance", "rejected", "merged", "retired", "blocked"
      ]
    },
    "reviews": {
      "type": "object",
      "properties": {
        "technical": { "$ref": "#/$defs/review" },
        "editorial": { "$ref": "#/$defs/review" },
        "chiefEditor": {
          "type": "object",
          "properties": {
            "status": { "enum": ["none", "in-review", "revision-requested", "accepted", "accepted-with-follow-up", "blocked", "retirement-recommended"] },
            "by": { "type": ["string", "null"] },
            "at": { "type": ["string", "null"], "format": "date" },
            "ref": { "type": ["string", "null"], "description": "Live-review report, editorial/live-reviews/<type>/<slug>.md." }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Live-review findings (strategy 4, Gate 8). Open critical or major findings block acceptance.",
      "items": {
        "type": "object",
        "required": ["id", "location", "problem", "action", "priority", "acceptance", "status"],
        "properties": {
          "id": { "type": "string" },
          "location": { "type": "string" },
          "problem": { "type": "string" },
          "whyItMatters": { "type": "string" },
          "action": { "type": "string" },
          "priority": { "enum": ["critical", "major", "minor"] },
          "acceptance": { "type": "string", "description": "Evidence that shows the finding is resolved, checked on the live page." },
          "status": { "enum": ["open", "fixed-awaiting-re-review", "closed", "accepted-limitation"] },
          "opened": { "type": "string", "format": "date" },
          "closed": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "author": { "type": ["string", "null"] },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "disclosures": { "type": "array", "items": { "type": "string" }, "description": "Conflicts of interest, sponsorship, AI use specific to this item." },
    "mergedInto": { "type": "string", "description": "Required when status is merged: id of the item that absorbed this one." },
    "redirect": { "type": "string", "description": "Required when status is retired: the URL readers are sent to, or \"none\" with a note in history." },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "status"],
        "properties": {
          "at": { "type": "string", "format": "date" },
          "status": { "type": "string" },
          "from": { "type": "string" },
          "by": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "properties": {
        "status": { "enum": ["none", "pass", "fail", "n/a"] },
        "ref": { "type": ["string", "null"] }
      }
    }
  }
}
