{
  "version": 1,
  "publication": {
    "id": "example",
    "name": "Example Docs",
    "fullName": "Example Engineering Documentation",
    "url": "https://docs.example.com",
    "standards": "editorial/standards.md",
    "identity": "One or two sentences: what this publication is, what it is not, and what it never claims.",
    "audience": "Who reads it, what they already know, and what they come for."
  },
  "language": {
    "variant": "en-US",
    "serialComma": true,
    "contractions": "allow",
    "headingCase": "sentence",
    "titleCase": "sentence"
  },
  "properNouns": [],
  "content": {
    "types": {
      "article": {
        "label": "Article",
        "globs": ["content/posts/**/*.md", "content/posts/**/*.mdx"],
        "route": "/posts/{slug}",
        "requiredFields": ["title", "description", "date"]
      },
      "guide": {
        "label": "Guide",
        "globs": ["docs/**/*.md"],
        "route": "/docs/{slug}",
        "requiredFields": ["title", "description"],
        "requiredSections": ["Prerequisites"]
      }
    },
    "exclude": ["**/drafts/**", "**/_*.md"],
    "fields": {
      "title": "title",
      "description": "description",
      "published": "date",
      "updated": "lastmod",
      "series": "series",
      "seriesOrder": "weight",
      "draft": "draft",
      "example": "example"
    },
    "pages": { "dist": "public", "routes": ["/", "/about"], "prefixes": ["/tags/"] }
  },
  "thresholds": {
    "titleMaxChars": 70,
    "descriptionMinChars": 70,
    "descriptionMaxChars": 160,
    "sentenceMaxWords": 35,
    "paragraphMaxWords": 150,
    "headingMaxWords": 10
  },
  "glossary": "editorial/glossary.json",
  "rules": {
    "spelling-variant": "warning",
    "terminology": "warning",
    "phrases": "warning",
    "intensifiers": "suggestion",
    "contractions": "off",
    "heading-case": "warning",
    "series-sections": "off",
    "acronym-expansion": "suggestion"
  },
  "acronyms": { "known": ["API", "HTTP", "URL", "JSON", "CPU"] },
  "references": { "sectionHeadings": ["References", "Further reading", "Sources"] },
  "review": {
    "recordsDir": "editorial/records",
    "auditDir": "editorial/audit",
    "requiredStages": {
      "article": ["developmental", "copy", "factCheck", "technical", "publishing", "qa"],
      "guide": ["copy", "technical", "publishing", "qa"]
    },
    "minimumTotal": { "article": 22, "guide": 21 },
    "minimumPerDimension": 3
  },
  "validation": {
    "commands": [
      { "name": "Build", "run": "hugo --minify" },
      { "name": "Links", "run": "lychee --offline public" }
    ],
    "site": { "dist": "public", "descriptionMaxChars": 170 }
  }
}
